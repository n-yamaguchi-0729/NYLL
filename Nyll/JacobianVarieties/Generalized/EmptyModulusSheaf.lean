import Nyll.JacobianVarieties.Generalized.EmptyModulus
import Mathlib.AlgebraicGeometry.Cover.Open
import Mathlib.CategoryTheory.Sites.Over

/-!
# The empty-modulus Picard sheaf is the ordinary relative Picard sheaf

Twists by a line bundle from the parameter scheme disappear on its actual
trivializing open cover. Equality in the quotient generated by such twists
therefore implies local equality of chosen-rigidified classes. The actual
forgetful map is a local bijection and becomes an isomorphism upon fppf
sheafification, without a section or field hypothesis on the curve.
-/

noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite

namespace AlgebraicGeometry.GeneralizedJacobian.EmptyModulus

variable {R : Type u} [CommRing R] {X D : Scheme.{u}}
  (c : X ⟶ Spec (CommRingCat.of R)) (i : D ⟶ X) [IsEmpty D]

private def canonicalClass (T : Over (Spec (CommRingCat.of R)))
    (M : RelPicard.Unrigidified.LineBundle c T.hom) :
    (modulusPicardPresheaf c i).obj (op T) :=
  RigidifiedLineBundle.classOf (ofLineBundle c i M)

private theorem map_canonicalClass {T T' : Over (Spec (CommRingCat.of R))}
    (f : T' ⟶ T) (M : RelPicard.Unrigidified.LineBundle c T.hom) :
    (modulusPicardPresheaf c i).map f.op (canonicalClass c i T M) =
      canonicalClass c i T'
        (RelPicard.Unrigidified.pullbackAlong ⟨f.left, f.w⟩ M) :=
  Quotient.sound ⟨compatibleIso (CategoryTheory.Iso.refl _)⟩

private def LocallyEqual (T : Over (Spec (CommRingCat.of R)))
    (M N : RelPicard.Unrigidified.LineBundle c T.hom) : Prop :=
  Presheaf.equalizerSieve (F := modulusPicardPresheaf c i) (X := op T)
    (canonicalClass c i T M) (canonicalClass c i T N) ∈
    (Scheme.fppfTopology.over (Spec (CommRingCat.of R))) T

private theorem locallyEqual_refl (T : Over (Spec (CommRingCat.of R)))
    (M : RelPicard.Unrigidified.LineBundle c T.hom) : LocallyEqual c i T M M := by
  unfold LocallyEqual
  rw [Presheaf.equalizerSieve_self_eq_top]
  exact (Scheme.fppfTopology.over (Spec (CommRingCat.of R))).top_mem T

private theorem locallyEqual_symm {T : Over (Spec (CommRingCat.of R))}
    {M N : RelPicard.Unrigidified.LineBundle c T.hom}
    (h : LocallyEqual c i T M N) : LocallyEqual c i T N M := by
  apply (Scheme.fppfTopology.over (Spec (CommRingCat.of R))).superset_covering ?_ h
  intro T' f hf
  exact hf.symm

private theorem locallyEqual_trans {T : Over (Spec (CommRingCat.of R))}
    {M N P : RelPicard.Unrigidified.LineBundle c T.hom}
    (h : LocallyEqual c i T M N) (h' : LocallyEqual c i T N P) :
    LocallyEqual c i T M P := by
  apply (Scheme.fppfTopology.over (Spec (CommRingCat.of R))).superset_covering ?_
    ((Scheme.fppfTopology.over (Spec (CommRingCat.of R))).intersection_covering h h')
  intro T' f hf
  exact hf.1.trans hf.2

/-- An actual base twist becomes an isomorphism on the actual trivializing
cover of its base line bundle. -/
private theorem locallyEqual_of_baseTwist {T : Over (Spec (CommRingCat.of R))}
    {M N : RelPicard.Unrigidified.LineBundle c T.hom}
    (h : RelPicard.Unrigidified.BaseTwist c T.hom M N) : LocallyEqual c i T M N := by
  classical
  obtain ⟨Q, hQ, ⟨e⟩⟩ := h
  choose U hx he using hQ.exists_trivialization
  let cover : T.left.OpenCover := Scheme.Cover.mkOfCovers
    (P := (@IsOpenImmersion : MorphismProperty Scheme.{u})) T.left
    (fun x => (U x).toScheme) (fun x => (U x).ι)
    (fun x => ⟨x, ⟨x, hx x⟩, rfl⟩)
  let V (x : T.left) : Over (Spec (CommRingCat.of R)) := Over.mk ((U x).ι ≫ T.hom)
  let f (x : T.left) : V x ⟶ T := Over.homMk (U x).ι
  have hcover : Sieve.ofArrows V f ∈
      (Scheme.fppfTopology.over (Spec (CommRingCat.of R))) T := by
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
    apply Precoverage.toGrothendieck_mono Scheme.zariskiPrecoverage_le_fppfPrecoverage
    exact cover.mem_grothendieckTopology
  apply (Scheme.fppfTopology.over (Spec (CommRingCat.of R))).superset_covering ?_ hcover
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  intro x
  change (modulusPicardPresheaf c i).map (f x).op (canonicalClass c i T M) =
    (modulusPicardPresheaf c i).map (f x).op (canonicalClass c i T N)
  rw [map_canonicalClass, map_canonicalClass]
  exact Quotient.sound ⟨compatibleIso
    (baseTwistPullbackIso ⟨(U x).ι, rfl⟩ M N Q e (he x).some).symm⟩

private theorem locallyEqual_of_eqvGen {T : Over (Spec (CommRingCat.of R))}
    {M N : RelPicard.Unrigidified.LineBundle c T.hom}
    (h : Relation.EqvGen (RelPicard.Unrigidified.BaseTwist c T.hom) M N) :
    LocallyEqual c i T M N := by
  induction h with
  | rel M N h => exact locallyEqual_of_baseTwist c i h
  | refl M => exact locallyEqual_refl c i T M
  | symm M N h ih => exact locallyEqual_symm c i ih
  | trans M N P h h' ih ih' => exact locallyEqual_trans c i ih ih'

/-- Forgetting an empty modulus is locally injective: all base twists in
the ordinary Picard relation are locally trivial on the parameter scheme. -/
theorem forgetModulusPresheaf_isLocallyInjective :
    Presheaf.IsLocallyInjective (Scheme.fppfTopology.over (Spec (CommRingCat.of R)))
      (forgetModulusPresheaf c i) := by
  constructor
  intro T x y h
  induction x using Quotient.ind with
  | _ M =>
    induction y using Quotient.ind with
    | _ N =>
      have hr : Relation.EqvGen (RelPicard.Unrigidified.BaseTwist c T.unop.hom)
          ⟨M.L, M.isInvertible⟩ ⟨N.L, N.isInvertible⟩ :=
        Quot.eqvGen_exact h
      have hl := locallyEqual_of_eqvGen c i hr
      have hM : RigidifiedLineBundle.classOf M =
          canonicalClass c i T.unop ⟨M.L, M.isInvertible⟩ :=
        Quotient.sound ⟨ofLineBundleIso c i M⟩
      have hN : RigidifiedLineBundle.classOf N =
          canonicalClass c i T.unop ⟨N.L, N.isInvertible⟩ :=
        Quotient.sound ⟨ofLineBundleIso c i N⟩
      exact (congrArg₂
        (fun a b : (modulusPicardPresheaf c i).obj T =>
          Presheaf.equalizerSieve (F := modulusPicardPresheaf c i) (X := T) a b ∈
            (Scheme.fppfTopology.over (Spec (CommRingCat.of R))) T.unop) hM hN).mpr hl

/-- The existing forgetful morphism itself becomes an isomorphism after
fppf sheafification, not merely an unspecified comparison of carriers. -/
theorem isIso_forgetModulusSheaf : IsIso (forgetModulusSheaf c i) := by
  let J := Scheme.fppfTopology.over (Spec (CommRingCat.of R))
  have : Presheaf.IsLocallyInjective J (forgetModulusPresheaf c i) :=
    forgetModulusPresheaf_isLocallyInjective c i
  have : Presheaf.IsLocallySurjective J (forgetModulusPresheaf c i) :=
    forgetModulusPresheaf_isLocallySurjective c i
  have hm : IsIso ((presheafToSheaf J (Type (u + 1))).map (forgetModulusPresheaf c i)) :=
    (J.W_iff _).mp (J.W_of_isLocallyBijective (forgetModulusPresheaf c i))
  have he : (presheafToSheaf J (Type (u + 1))).map (forgetModulusPresheaf c i) =
      forgetModulusSheaf c i :=
    modulusPicardSheafLift_unique _ _ (toSheafify_naturality J
      (forgetModulusPresheaf c i)).symm
  exact he ▸ hm

/-- The empty-modulus Picard sheaf is canonically the ordinary relative
Picard sheaf, with the canonical map given by forgetting rigidification. -/
def ordinaryPicardSheafIso : modulusPicardSheaf c i ≅ ordinaryRelativePicardSheaf c := by
  let : IsIso (forgetModulusSheaf c i) := isIso_forgetModulusSheaf c i
  exact asIso (forgetModulusSheaf c i)

end AlgebraicGeometry.GeneralizedJacobian.EmptyModulus
