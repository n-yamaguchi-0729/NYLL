import Nyll.EtaleCohomology.Classical.FieldKummerH1Quotient
import Nyll.SchemeTheory.RingTheory.Henselian.HenselianUnitRoots
import Mathlib.Data.ZMod.Basic

/-!
# Kummer generation on a strictly Henselian trait's generic point

The actual derived roots-of-unity H1 is generated by a chosen
uniformizer's Kummer class. This uses the proved unit-root lifting
and the actual field Kummer cokernel, not a substitute cohomology.
-/

noncomputable section
universe u
open AlgebraicGeometry CategoryTheory Limits

namespace EtaleCohomology

/-- Every actual derived Kummer H1 class on the generic point of a
strictly Henselian DVR is an integral multiple of its uniformizer class. -/
theorem fieldKummerH1_generated_by_uniformizer
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    {n : ℕ} (hn : 0 < n) (hnR : IsUnit (n : R))
    {π : R} (hπ : Irreducible π)
    (v : Sheaf.H.{u} (etaleRootsOfUnitySheaf (Spec (.of K)) n) 1) :
    ∃ a : ℤ, v = a • fieldKummerUnitClass K hn
      (Additive.ofMul (Units.mk0 (algebraMap R K π)
        (by
          intro h
          apply hπ.ne_zero
          apply IsFractionRing.injective R K
          exact h.trans (map_zero (algebraMap R K)).symm))) := by
  let πK : Kˣ := Units.mk0 (algebraMap R K π)
    (by
      intro h
      apply hπ.ne_zero
      apply IsFractionRing.injective R K
      exact h.trans (map_zero (algebraMap R K)).symm)
  obtain ⟨x, rfl⟩ := fieldKummerUnitClass_surjective K hn v
  obtain ⟨y, a, hxy⟩ :=
    HenselianLocalRing.fractionUnit_eq_pow_mul_uniformizer_zpow
      R K n hnR hπ x.toMul
  have hx : x.toMul = y ^ n * πK ^ a := by
    apply Units.ext
    have hyPow : ((y ^ n : Kˣ) : K) = (y : K) ^ n := map_pow (Units.coeHom K) y n
    simpa only [Units.val_mul, hyPow, Units.val_zpow_eq_zpow_val,
      πK, Units.val_mk0] using hxy
  have hxa : x = n • Additive.ofMul y + a • Additive.ofMul πK :=
    congrArg Additive.ofMul hx
  refine ⟨a, ?_⟩
  change fieldKummerUnitClass K hn x =
    a • fieldKummerUnitClass K hn (Additive.ofMul πK)
  rw [hxa, map_add, map_zsmul, fieldKummerUnitClass_nsmul_eq_zero, zero_add]

/-- The actual Kummer class of a DVR uniformizer has precisely the
relations given by divisibility by the coefficient integer. -/
theorem fieldKummerUniformizerClass_zsmul_eq_zero_iff
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    {n : ℕ} (hn : 0 < n) {π : R} (hπ : Irreducible π)
    (πK : Kˣ) (hπK : (πK : K) = algebraMap R K π) (a : ℤ) :
    a • fieldKummerUnitClass K hn (Additive.ofMul πK) = 0 ↔
      (n : ℤ) ∣ a := by
  constructor
  · intro ha
    have hz : fieldKummerUnitClass K hn (a • Additive.ofMul πK) = 0 := by
      rw [map_zsmul, ha]
    obtain ⟨y, hy⟩ := (fieldKummerUnitClass_eq_zero_iff K hn _).mp hz
    obtain ⟨b, v, hv⟩ :=
      IsDiscreteValuationRing.exists_units_eq_smul_zpow_of_irreducible
        hπ y.toMul.ne_zero
    have hyu : y.toMul =
        Units.map (algebraMap R K).toMonoidHom v * πK ^ b := by
      apply Units.ext
      rw [Units.val_mul, Units.coe_map, Units.val_zpow_eq_zpow_val, hπK]
      change (y.toMul : K) =
        (algebraMap R K) (v : R) * (algebraMap R K π) ^ b
      simpa only [Units.smul_def, Algebra.smul_def] using hv
    have hpow : πK ^ a = y.toMul ^ n := (congrArg Additive.toMul hy).symm
    have he : πK ^ a =
        Units.map (algebraMap R K).toMonoidHom (v ^ n) *
          πK ^ (b * (n : ℤ)) := by
      rw [hpow, hyu, mul_pow, map_pow, zpow_mul, zpow_natCast]
    have hab := IsDiscreteValuationRing.uniformizer_zpow_eq_unit_mul_zpow_exponent
      R K hπ πK hπK a (b * (n : ℤ)) (v ^ n) he
    exact ⟨b, hab.trans (mul_comm b (n : ℤ))⟩
  · rintro ⟨b, rfl⟩
    rw [mul_comm (n : ℤ) b, mul_zsmul, natCast_zsmul,
      ← map_nsmul, fieldKummerUnitClass_nsmul_eq_zero, smul_zero]

/-- Actual derived roots-of-unity H1 of the fraction field of a strictly
Henselian DVR is cyclic of order n, with the chosen uniformizer as generator. -/
noncomputable def fieldKummerUniformizerEquiv
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    {n : ℕ} (hn : 0 < n) (hnR : IsUnit (n : R))
    {π : R} (hπ : Irreducible π)
    (πK : Kˣ) (hπK : (πK : K) = algebraMap R K π) :
    ZMod n ≃+ Sheaf.H.{u} (etaleRootsOfUnitySheaf (Spec (.of K)) n) 1 := by
  let c := fieldKummerUnitClass K hn (Additive.ofMul πK)
  let a : ℤ →+ Sheaf.H.{u} (etaleRootsOfUnitySheaf (Spec (.of K)) n) 1 :=
    { toFun := fun m => m • c
      map_zero' := zero_zsmul c
      map_add' := fun m k => add_zsmul c m k }
  have ha : a n = 0 := by
    change (n : ℤ) • c = 0
    rw [natCast_zsmul]
    change n • fieldKummerUnitClass K hn (Additive.ofMul πK) = 0
    rw [← map_nsmul, fieldKummerUnitClass_nsmul_eq_zero]
  let f : ZMod n →+ Sheaf.H.{u} (etaleRootsOfUnitySheaf (Spec (.of K)) n) 1 :=
    ZMod.lift n ⟨a, ha⟩
  have hf (m : ℤ) : f (m : ZMod n) = m • c :=
    ZMod.lift_coe n ⟨a, ha⟩ m
  refine AddEquiv.ofBijective f ⟨?_, ?_⟩
  · intro x y hxy
    obtain ⟨b, rfl⟩ := ZMod.intCast_surjective x
    obtain ⟨d, rfl⟩ := ZMod.intCast_surjective y
    have hbd : (b - d) • c = 0 := by
      rw [sub_zsmul, ← hf b, ← hf d, hxy, add_neg_cancel]
    have hdiv : (n : ℤ) ∣ b - d :=
      (fieldKummerUniformizerClass_zsmul_eq_zero_iff
        R K hn hπ πK hπK (b - d)).mp hbd
    apply sub_eq_zero.mp
    rw [← Int.cast_sub]
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (b - d) n).mpr hdiv
  · intro v
    obtain ⟨b, hb⟩ :=
      fieldKummerH1_generated_by_uniformizer R K hn hnR hπ v
    have hunit : Units.mk0 (algebraMap R K π)
        (by
          intro h
          apply hπ.ne_zero
          apply IsFractionRing.injective R K
          exact h.trans (map_zero (algebraMap R K)).symm) = πK := by
      apply Units.ext
      exact hπK.symm
    refine ⟨(b : ZMod n), ?_⟩
    rw [hf]
    exact (hb.trans (congrArg
      (fun z : Kˣ => b • fieldKummerUnitClass K hn (Additive.ofMul z)) hunit)).symm

/-- Units of a strictly Henselian local ring have zero actual Kummer
class in its fraction field when the coefficient integer is invertible. -/
theorem fieldKummerUnitClass_mappedUnit_eq_zero
    (R K : Type u) [CommRing R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)]
    [Field K] [CharZero K] [Algebra R K]
    {n : ℕ} (hn : 0 < n) (hnR : IsUnit (n : R)) (u : Rˣ) :
    fieldKummerUnitClass K hn
      (Additive.ofMul (Units.map (algebraMap R K).toMonoidHom u)) = 0 := by
  obtain ⟨v, hv⟩ := HenselianLocalRing.units_pow_surjective_of_isSepClosed R n hnR u
  apply (fieldKummerUnitClass_eq_zero_iff K hn _).mpr
  refine ⟨Additive.ofMul (Units.map (algebraMap R K).toMonoidHom v), ?_⟩
  change Additive.ofMul ((Units.map (algebraMap R K).toMonoidHom v) ^ n) = _
  exact congrArg Additive.ofMul
    ((map_pow (Units.map (algebraMap R K).toMonoidHom) v n).symm.trans
      (congrArg (Units.map (algebraMap R K).toMonoidHom) hv))

/-- The actual Kummer class of a uniformizer is independent of the chosen
uniformizer in a strictly Henselian DVR. -/
theorem fieldKummerUniformizerClass_eq
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    {n : ℕ} (hn : 0 < n) (hnR : IsUnit (n : R))
    {π ρ : R} (hπ : Irreducible π) (hρ : Irreducible ρ)
    (πK ρK : Kˣ) (hπK : (πK : K) = algebraMap R K π)
    (hρK : (ρK : K) = algebraMap R K ρ) :
    fieldKummerUnitClass K hn (Additive.ofMul πK) =
      fieldKummerUnitClass K hn (Additive.ofMul ρK) := by
  obtain ⟨u, hu⟩ := IsDiscreteValuationRing.associated_of_irreducible R hπ hρ
  have hρu : ρK = πK * Units.map (algebraMap R K).toMonoidHom u := by
    apply Units.ext
    rw [hρK, Units.val_mul, hπK, Units.coe_map]
    calc
      (algebraMap R K) ρ = (algebraMap R K) (π * (u : R)) :=
        (congrArg (algebraMap R K) hu).symm
      _ = (algebraMap R K) π * (algebraMap R K) (u : R) := map_mul _ _ _
  rw [hρu]
  change fieldKummerUnitClass K hn (Additive.ofMul πK) =
    fieldKummerUnitClass K hn
      (Additive.ofMul πK + Additive.ofMul (Units.map (algebraMap R K).toMonoidHom u))
  rw [map_add, fieldKummerUnitClass_mappedUnit_eq_zero R K hn hnR, add_zero]

/-- Integral exponents under the uniformizer equivalence are the actual
Kummer classes of the corresponding powers. -/
theorem fieldKummerUniformizerEquiv_intCast
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    {n : ℕ} (hn : 0 < n) (hnR : IsUnit (n : R))
    {π : R} (hπ : Irreducible π)
    (πK : Kˣ) (hπK : (πK : K) = algebraMap R K π) (a : ℤ) :
    fieldKummerUniformizerEquiv R K hn hnR hπ πK hπK (a : ZMod n) =
      a • fieldKummerUnitClass K hn (Additive.ofMul πK) := by
  let c : Sheaf.H.{u} (etaleRootsOfUnitySheaf (Spec (.of K)) n) 1 :=
    fieldKummerUnitClass K hn (Additive.ofMul πK)
  let f : ℤ →+ Sheaf.H.{u} (etaleRootsOfUnitySheaf (Spec (.of K)) n) 1 :=
    { toFun := fun m => m • c
      map_zero' := zero_zsmul c
      map_add' := fun m k => add_zsmul c m k }
  have hf : f n = 0 := by
    change (n : ℤ) • c = 0
    rw [natCast_zsmul]
    change n • fieldKummerUnitClass K hn (Additive.ofMul πK) = 0
    rw [← map_nsmul, fieldKummerUnitClass_nsmul_eq_zero]
  change ZMod.lift n ⟨f, hf⟩ (a : ZMod n) = _
  exact ZMod.lift_coe n ⟨f, hf⟩ a

/-- The residue-coordinate equivalence in actual Kummer H1 is independent
of the uniformizer used to construct it. -/
theorem fieldKummerUniformizerEquiv_eq
    (R K : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    [Field K] [CharZero K] [Algebra R K] [IsFractionRing R K]
    {n : ℕ} (hn : 0 < n) (hnR : IsUnit (n : R))
    {π ρ : R} (hπ : Irreducible π) (hρ : Irreducible ρ)
    (πK ρK : Kˣ) (hπK : (πK : K) = algebraMap R K π)
    (hρK : (ρK : K) = algebraMap R K ρ) :
    fieldKummerUniformizerEquiv R K hn hnR hπ πK hπK =
      fieldKummerUniformizerEquiv R K hn hnR hρ ρK hρK := by
  apply AddEquiv.ext
  intro x
  obtain ⟨a, rfl⟩ := ZMod.intCast_surjective x
  rw [fieldKummerUniformizerEquiv_intCast, fieldKummerUniformizerEquiv_intCast,
    fieldKummerUniformizerClass_eq R K hn hnR hπ hρ πK ρK hπK hρK]

end EtaleCohomology
