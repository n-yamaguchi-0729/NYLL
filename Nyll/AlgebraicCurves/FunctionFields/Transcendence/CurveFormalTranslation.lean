import Nyll.SchemeTheory.RingTheory.Henselian.RationalFunctionFormalTranslation
import Nyll.SchemeTheory.RingTheory.Henselian.FiniteSeparableFormalLift
import Nyll.AlgebraicCurves.FunctionFields.Transcendence.CurveSeparatingTranscendental

/-! # Formal translation along a separating curve parameter

The canonical intermediate field generated by a separating transcendental
parameter retains its given inclusion into the curve function field. Formal
translation on the rational subfield lifts through the actual finite separable
extension, giving a unique algebra homomorphism with identity constant term
and the prescribed translation of the parameter.
-/

noncomputable section

namespace AlgebraicCurve

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- Translation of a separating transcendental parameter extends uniquely to
the whole field, as a `K`-algebra homomorphism with identity constant term. -/
theorem existsUnique_formalTranslation_of_finiteSeparable
    (t : F) (ht : Transcendental K t)
    [FiniteDimensional (IntermediateField.adjoin K {t}) F]
    [Algebra.IsSeparable (IntermediateField.adjoin K {t}) F] :
    ∃! σ : F →ₐ[K] PowerSeries F,
      σ t = PowerSeries.C t + PowerSeries.X ∧
        PowerSeries.constantCoeff.comp σ.toRingHom = RingHom.id F := by
  let R : IntermediateField K F := IntermediateField.adjoin K {t}
  let e : RatFunc K ≃ₐ[K] R := RatFunc.algEquivOfTranscendental t ht
  let τ : R →ₐ[K] PowerSeries F :=
    (RatFunc.formalTranslation t ht).comp e.symm.toAlgHom
  have hτ : PowerSeries.constantCoeff.comp τ.toRingHom = algebraMap R F := by
    apply RingHom.ext
    intro x
    change PowerSeries.constantCoeff (RatFunc.formalTranslation t ht (e.symm x)) =
      (x : F)
    rw [RatFunc.constantCoeff_formalTranslation]
    exact congrArg (fun y : R => (y : F)) (e.apply_symm_apply x)
  obtain ⟨σ, hσ, hUnique⟩ :=
    PowerSeries.existsUnique_formalLift_finiteSeparable (R := R) (F := F) τ.toRingHom hτ
  let s : F →ₐ[K] PowerSeries F :=
    { toRingHom := σ
      commutes' := by
        intro a
        rw [IsScalarTower.algebraMap_apply K R F]
        exact (RingHom.congr_fun hσ.1 (algebraMap K R a)).trans (τ.commutes a) }
  have hs : s t = PowerSeries.C t + PowerSeries.X := by
    have h := RingHom.congr_fun hσ.1 (IntermediateField.AdjoinSimple.gen K t)
    change σ t = RatFunc.formalTranslation t ht
      (e.symm (IntermediateField.AdjoinSimple.gen K t)) at h
    have he : e.symm (IntermediateField.AdjoinSimple.gen K t) = (RatFunc.X : RatFunc K) :=
      RatFunc.algEquivOfTranscendental_symm_gen t ht
    rw [he, RatFunc.formalTranslation_X] at h
    exact h
  refine ⟨s, ⟨hs, hσ.2⟩, ?_⟩
  intro ρ hρ
  have heX : ((e RatFunc.X : R) : F) = t :=
    RatFunc.algEquivOfTranscendental_X t ht
  have hρrat : (ρ.comp R.val).comp e.toAlgHom = RatFunc.formalTranslation t ht := by
    apply IsLocalization.algHom_ext (nonZeroDivisors (Polynomial K))
    apply Polynomial.algHom_ext
    change ρ ((e RatFunc.X : R) : F) = RatFunc.formalTranslation t ht RatFunc.X
    rw [heX, RatFunc.formalTranslation_X]
    exact hρ.1
  have hρbase : ρ.comp R.val = τ := by
    apply AlgHom.ext
    intro x
    have h := AlgHom.congr_fun hρrat (e.symm x)
    change ρ ((e (e.symm x) : R) : F) =
      RatFunc.formalTranslation t ht (e.symm x) at h
    rw [e.apply_symm_apply] at h
    exact h
  apply AlgHom.coe_ringHom_injective
  exact hUnique ρ.toRingHom ⟨congrArg AlgHom.toRingHom hρbase, hρ.2⟩

/-- A curve function field of essential finite type over a perfect field has
an actual separating parameter and its unique formal translation. Both the
finite separable extension and the translation are constructed here. -/
theorem IsCurveOver.exists_separating_formalTranslation
    [PerfectField K] [Algebra.EssFiniteType K F] [IsCurveOver K F] :
    ∃ t : F, Transcendental K t ∧
      FiniteDimensional (IntermediateField.adjoin K {t}) F ∧
      Algebra.IsSeparable (IntermediateField.adjoin K {t}) F ∧
      ∃! σ : F →ₐ[K] PowerSeries F,
        σ t = PowerSeries.C t + PowerSeries.X ∧
          PowerSeries.constantCoeff.comp σ.toRingHom = RingHom.id F := by
  obtain ⟨t, ht, hfinite, hseparable⟩ :=
    IsCurveOver.exists_separating_transcendental (K := K) (F := F)
  have : FiniteDimensional (IntermediateField.adjoin K {t}) F := hfinite
  have : Algebra.IsSeparable (IntermediateField.adjoin K {t}) F := hseparable
  exact ⟨t, ht, hfinite, hseparable,
    existsUnique_formalTranslation_of_finiteSeparable t ht⟩

end AlgebraicCurve
