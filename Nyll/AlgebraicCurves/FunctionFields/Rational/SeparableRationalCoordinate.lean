import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.FieldTheory.Separable
import Mathlib.RingTheory.Finiteness.Basic

/-! # Separability for the actual prescribed rational coordinate

The finite separable presentation is transported through the intermediate
field generated by the image of X. Unlike choosing an unrelated separating
parameter, this retains the exact rational-function map used by the finite
curve morphism and its Cartier-fibre trace.
-/

noncomputable section

namespace AlgebraicCurve.FunctionField

/-- A separating image of X makes the supplied rational-coordinate map
finite separable, with its own induced algebra structure. -/
theorem finite_separable_ratFuncMap_of_parameter
    {K F : Type*} [Field K] [Field F] [Algebra K F]
    (φ : RatFunc K →ₐ[K] F) (htr : Transcendental K (φ RatFunc.X))
    [FiniteDimensional (IntermediateField.adjoin K {φ RatFunc.X}) F]
    [Algebra.IsSeparable (IntermediateField.adjoin K {φ RatFunc.X}) F] :
    let _ : Algebra (RatFunc K) F := φ.toRingHom.toAlgebra
    FiniteDimensional (RatFunc K) F ∧ Algebra.IsSeparable (RatFunc K) F := by
  intro algRF
  let t := φ RatFunc.X
  let E := IntermediateField.adjoin K {t}
  let e : RatFunc K ≃ₐ[K] E := RatFunc.algEquivOfTranscendental t htr
  let j : RatFunc K →ₐ[K] F := E.val.comp e.toAlgHom
  have hj : j = φ := by
    apply IsLocalization.algHom_ext (nonZeroDivisors (Polynomial K))
    apply Polynomial.algHom_ext
    change algebraMap E F (e RatFunc.X) = φ RatFunc.X
    exact RatFunc.algEquivOfTranscendental_X t htr
  have hsq : (algebraMap (RatFunc K) F).comp e.symm.toRingEquiv.toRingHom =
      (RingEquiv.refl F).toRingHom.comp (algebraMap E F) := by
    apply RingHom.ext
    intro x
    change φ (e.symm x) = algebraMap E F x
    rw [← hj]
    change algebraMap E F (e (e.symm x)) = _
    rw [e.apply_symm_apply]
  exact ⟨Module.Finite.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl F) hsq,
    Algebra.IsSeparable.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl F) hsq⟩

end AlgebraicCurve.FunctionField
