module

public import Nyll.AlgebraicCurves.Geometry.Schemes.FunctionFields.FunctionFieldConstantExtension
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
public import Mathlib.FieldTheory.IntermediateField.Basic

/-!
# The image of an actual constant pullback function field

The function field of a constant pullback is generated by the original
function field and the new constants. Under any embedding into an ambient
field, its image is therefore the compositum with the image of those actual
constants. The geometric generation theorem supplies the generation used
here; it is not a hypothesis of the geometric conclusion.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicCurve
open Scheme.TwoAffineOpenCover

namespace AlgebraicGeometry

private theorem fieldRange_eq_adjoin_constants
    {C F L Ω : Type*} [Field C] [Field F] [Field L] [Field Ω]
    [Algebra C L] (φ : F →+* L)
    (hgen : IntermediateField.adjoin C (Set.range φ) = ⊤)
    (β : L →+* Ω) :
    let _ : Algebra F L := φ.toAlgebra
    let _ : Algebra F Ω := (β.comp φ).toAlgebra
    let b : L →ₐ[F] Ω := { β with commutes' := fun _ => rfl }
    b.fieldRange = IntermediateField.adjoin F
      (Set.range (β.comp (algebraMap C L))) := by
  intro instFL instFΩ b
  let T := IntermediateField.adjoin F (Set.range (β.comp (algebraMap C L)))
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    have hx : x ∈ IntermediateField.adjoin C (Set.range φ) := by
      rw [hgen]
      trivial
    change β x ∈ T
    refine IntermediateField.adjoin_induction C
      (motive := fun y _ => β y ∈ T) ?_ ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨a, rfl⟩
      exact T.algebraMap_mem a
    · intro a
      exact IntermediateField.subset_adjoin F _ ⟨a, rfl⟩
    · intro x y _ _ hx hy
      rw [map_add]
      exact T.add_mem hx hy
    · intro x _ hx
      rw [map_inv₀]
      exact T.inv_mem hx
    · intro x y _ _ hx hy
      rw [map_mul]
      exact T.mul_mem hx hy
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨a, rfl⟩
    exact ⟨algebraMap C L a, rfl⟩

/-- The genuine constant pullback admits a function-field map respecting
every germ. For every ambient embedding of this same pullback field, its
image is exactly the compositum with the embedded new constants. -/
theorem exists_functionField_constantExtension_compositum
    {K : Type} [Field K] (K' : Type) [Field K'] [Algebra K K']
    {X : Scheme} [IsIntegral X] (c : X ⟶ Spec (.of K))
    [IsIntegral (pullback c (specMap K K'))] :
    ∃ φ : X.functionField →+* (pullback c (specMap K K')).functionField,
      (∀ (U : X.Opens) [Nonempty U]
          [Nonempty ((pullback.fst c (specMap K K')) ⁻¹ᵁ U)]
          (a : Γ(X, U)),
        (pullback c (specMap K K')).germToFunctionField
          ((pullback.fst c (specMap K K')) ⁻¹ᵁ U)
          (((pullback.fst c (specMap K K')).app U).hom a) =
            φ (X.germToFunctionField U a)) ∧
      ∀ (Ω : Type) [Field Ω]
          (β : (pullback c (specMap K K')).functionField →+* Ω),
        let _ : Algebra X.functionField
            (pullback c (specMap K K')).functionField := φ.toAlgebra
        let _ : Algebra X.functionField Ω := (β.comp φ).toAlgebra
        let b : (pullback c (specMap K K')).functionField →ₐ[X.functionField] Ω :=
          { β with commutes' := fun _ => rfl }
        b.fieldRange = IntermediateField.adjoin X.functionField
          (Set.range (β.comp (baseToFunctionField
            (pullback.snd c (specMap K K'))))) := by
  let _ : Algebra K' (pullback c (specMap K K')).functionField :=
    (baseToFunctionField (pullback.snd c (specMap K K'))).toAlgebra
  obtain ⟨φ, hsq, hgen⟩ := exists_functionField_constantExtension K' c
  refine ⟨φ, hsq, ?_⟩
  intro Ω instΩ β
  exact fieldRange_eq_adjoin_constants φ hgen β

end AlgebraicGeometry
