/-!
# Ray detection in the original curve abelianization

The actual generic absolute Galois kernel is normally generated by the
literal normalization inertia at the actual scheme stalks. At a closed
point its absolute abelian image is the full unit Artin image of the
constructed function-field place. At the generic point the inertia is
trivial. Thus any ray modulus supported outside the original curve detects
every relation in the original curve Artin map.

The target is the topological abelianization of the original étale
fundamental group at its native geometric generic point. No quotient or
kernel comparison is supplied as a hypothesis.
-/

@[expose] public section

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale AlgebraicCurve
open FunctionField LocalClassFieldTheory
open scoped Pointwise

namespace EtaleFundamentalGroups.Inertia

universe u v

/-- The places obtained from the literal closed stalks of the original
curve, in its own function field. -/
def curveInteriorPlaces
    {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X]
    (c : X ⟶ Spec (.of k)) :
    let _ : Algebra k X.functionField := (baseToFunctionField c).toAlgebra
    Set (Place k X.functionField) := by
  intro baseAlgebra
  exact {v | ∃ x : X, IsClosed ({x} : Set X) ∧
    (algebraMap (X.presheaf.stalk x) X.functionField).range =
      v.toValuationSubring.toSubring}

section LocalRay

variable {k : Type u} {K : Type v} [Field k] [Finite k] [Field K] [Algebra k K]
  [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
  [HasPrincipalDivisors k K]

/-- A modulus with zero exponent at a place kills all of its full local
units in the corresponding native ray quotient. -/
theorem placeAbsoluteArtin_units_le_artinRaySubgroup
    (m : RayClass.Modulus k K) (v : Place k K) (hv : m v = 0) :
    (RayClass.localHigherUnitGroup v 0).map (placeAbsoluteArtin v).toMonoidHom ≤
      RayClass.artinRaySubgroup m := by
  classical
  rintro z ⟨u, hu, rfl⟩
  have hcong : IdeleGroup.placeIdele v u ∈ RayClass.congruenceSubgroup m := by
    intro w
    by_cases hw : w = v
    · subst w
      change IdeleGroup.component v (IdeleGroup.placeIdele v u) ∈ _
      rw [IdeleGroup.component_placeIdele_same, hv]
      exact hu
    · change IdeleGroup.component w (IdeleGroup.placeIdele v u) ∈ _
      rw [IdeleGroup.component_placeIdele_of_ne v w u hw]
      exact (RayClass.localHigherUnitGroup w (m w)).one_mem
  exact ⟨IdeleClassGroup.mk (IdeleGroup.placeIdele v u),
    ⟨IdeleGroup.placeIdele v u, hcong, rfl⟩, rfl⟩


/-- The original inertia comparison enters the ray congruence before a
concrete function field is substituted into the group calculations. -/
private theorem inertia_le_rayComap_of_unit_image
    (m : RayClass.Modulus k K) (v : Place k K) (hv : m v = 0)
    (I : Subgroup Gal(SeparableClosure K/K))
    (hI : I.map (localAbsoluteAbelianizationQuotientMap K) =
      (RayClass.localHigherUnitGroup v 0).map (placeAbsoluteArtin v).toMonoidHom) :
    I ≤ (RayClass.artinRaySubgroup m).comap (localAbsoluteAbelianizationQuotientMap K) :=
  Subgroup.map_le_iff_le_comap.mp
    (hI.le.trans (placeAbsoluteArtin_units_le_artinRaySubgroup m v hv))

end LocalRay

/-- The abelianization of an absolute Galois map, with the source retained as
the canonical profinite abelianization. Resolving the quotient coercion before
specializing the field retains its canonical group dictionaries. -/
def absoluteAbelianMap
    {K : Type u} [Field K] {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (f : Gal(SeparableClosure K/K) →ₜ* G) :
    localAbsoluteAbelianProfinite K →ₜ* TopologicalAbelianization G :=
  ProCGroups.Abelian.TopologicalAbelianization.map f

private theorem absoluteAbelianMap_ker
    {K : Type u} [Field K] {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] (f : Gal(SeparableClosure K/K) →ₜ* G)
    (hf : Function.Surjective f) :
    (absoluteAbelianMap f).toMonoidHom.ker =
      f.toMonoidHom.ker.map (localAbsoluteAbelianizationQuotientMap K) :=
  ProCGroups.Abelian.TopologicalAbelianization.ker_map_of_surjective f hf


section NativeRayKernel

variable {k : Type u} {K : Type v} [Field k] [Finite k] [Field K] [Algebra k K]
  [Algebra (RatFunc k) K] [IsScalarTower k (RatFunc k) K] [FunctionField k K]
  [HasPrincipalDivisors k K]

/-- Resolve the native Artin composition while its coefficient field is
abstract, retaining the original homomorphisms and quotient structures. -/
def absoluteArtinComp
    {G : Type*} [Group G] [TopologicalSpace G]
    (f : localAbsoluteAbelianProfinite K →ₜ* G) :
    IdeleClassGroup k K →ₜ* G :=
  f.comp (absoluteArtin k K)

/-- The native ray subgroup and the absolute abelianization use the same
quotient structures before a scheme function field is substituted. -/
private theorem absoluteAbelianMap_ker_le_artinRaySubgroup
    {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [T2Space G] (f : Gal(SeparableClosure K/K) →ₜ* G)
    (hf : Function.Surjective f) (m : RayClass.Modulus k K)
    (h : f.toMonoidHom.ker.map (localAbsoluteAbelianizationQuotientMap K) ≤
      RayClass.artinRaySubgroup m) :
    (absoluteAbelianMap f).toMonoidHom.ker ≤ RayClass.artinRaySubgroup m :=
  (absoluteAbelianMap_ker f hf).le.trans h

/-- Pull the actual native ray containment back through the original
absolute Artin map while its coefficient field is abstract. -/
private theorem absoluteArtinComp_ker_le_rayClassSubgroup
    {G : Type*} [Group G] [TopologicalSpace G]
    (f : localAbsoluteAbelianProfinite K →ₜ* G) (m : RayClass.Modulus k K)
    (h : f.toMonoidHom.ker ≤ RayClass.artinRaySubgroup m) :
    (absoluteArtinComp (k := k) f).toMonoidHom.ker ≤ RayClass.rayClassSubgroup m := by
  intro x hx
  have hmem : absoluteArtin k K x ∈ RayClass.artinRaySubgroup m := h hx
  exact (RayClass.artinRaySubgroup_comap_absoluteArtin m).le hmem

end NativeRayKernel

/-- The abelianization map induced by the original generic absolute
Galois map, retaining its actual algebraic-closure geometric point. -/
def curveAbelianizationMap (X : Scheme.{u}) [IsIntegral X] :
    localAbsoluteAbelianProfinite X.functionField →ₜ*
      TopologicalAbelianization
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField))) :=
  absoluteAbelianMap (K := X.functionField) (genericAbsoluteGaloisHom X)

/-- The original generic kernel has absolute abelian image contained in
every ray Artin subgroup whose modulus is supported outside the curve. -/
theorem genericAbsoluteGaloisHom_ker_image_le_artinRaySubgroup
    {k : Type u} [Field k] [Finite k] {X : Scheme.{u}}
    [IsIntegral X] [IsNormalIntegral X]
    (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c] :
    let _ : Algebra k X.functionField := (baseToFunctionField c).toAlgebra
    ∀ [Algebra (RatFunc k) X.functionField]
      [IsScalarTower k (RatFunc k) X.functionField] [FunctionField k X.functionField]
      [HasPrincipalDivisors k X.functionField]
      (m : RayClass.Modulus k X.functionField),
      (∀ v ∈ curveInteriorPlaces c, m v = 0) →
      (genericAbsoluteGaloisHom X).toMonoidHom.ker.map
          (localAbsoluteAbelianizationQuotientMap X.functionField) ≤
        RayClass.artinRaySubgroup m := by
  classical
  intro baseAlgebra rationalAlgebra rationalTower functionField principalDivisors m hm
  let K : Type u := X.functionField
  let Ω : Type u := SeparableClosure K
  let q : Gal(Ω/K) →* localAbsoluteAbelianProfinite K :=
    localAbsoluteAbelianizationQuotientMap K
  let H : Subgroup Gal(Ω/K) := (RayClass.artinRaySubgroup m).comap q
  have hclosed : IsClosed (H : Set Gal(Ω/K)) :=
    (RayClass.isClosed_artinRaySubgroup m).preimage QuotientGroup.continuous_mk
  have hgenerators : stalkNormalizationInertiaGenerators X ⊆ H := by
    apply (stalkNormalizationInertiaGenerators_subset_iff X H).mpr
    intro x
    by_cases hx : x = genericPoint X
    · rw [hx, absoluteStalkInertiaImage_genericPoint]
      exact bot_le
    · let : Algebra (X.presheaf.stalk x) Ω := X.stalkExtensionAlgebra x Ω
      have : IsScalarTower (X.presheaf.stalk x) K Ω :=
        IsScalarTower.of_algebraMap_eq' rfl
      let : MulSemiringAction Gal(Ω/K) (integralClosure (X.presheaf.stalk x) Ω) :=
        IsIntegralClosure.MulSemiringAction (X.presheaf.stalk x) K Ω
          (integralClosure (X.presheaf.stalk x) Ω)
      change (⨆ Q : MaximalSpectrum (integralClosure (X.presheaf.stalk x) Ω),
        Q.asIdeal.inertia Gal(Ω/K)) ≤ H
      apply iSup_le
      intro Q
      have : Q.asIdeal.IsMaximal := Q.isMaximal
      have hxclosed := isClosed_singleton_of_ne_genericPoint c x hx
      obtain ⟨v, hv, hI⟩ :=
        exists_closedStalk_place_abelian_inertia_image c x hxclosed Q.asIdeal
      have hvInterior : v ∈ curveInteriorPlaces c := by
        change ∃ z : X, IsClosed ({z} : Set X) ∧
          (algebraMap (X.presheaf.stalk z) K).range =
            v.toValuationSubring.toSubring
        exact ⟨x, hxclosed, hv⟩
      have hvZero : m v = 0 := hm v hvInterior
      exact inertia_le_rayComap_of_unit_image m v hvZero
        (Q.asIdeal.inertia Gal(Ω/K)) hI
  have hker : (genericAbsoluteGaloisHom X).toMonoidHom.ker ≤ H := by
    rw [genericAbsoluteGaloisHom_ker_eq_normalClosure_affineNormalizationInertia,
      affineNormalizationInertiaGenerators_eq_stalk]
    exact Subgroup.topologicalClosure_minimal _
      (Subgroup.normalClosure_le_normal hgenerators) hclosed
  rintro z ⟨σ, hσ, rfl⟩
  exact hker hσ

/-- Passage to topological abelianization preserves the native ray
containment for the actual generic map. -/
theorem curveAbelianizationMap_ker_le_artinRaySubgroup
    {k : Type u} [Field k] [Finite k] {X : Scheme.{u}}
    [IsIntegral X] [IsNormalIntegral X]
    (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c] :
    let _ : Group (localAbsoluteAbelianProfinite X.functionField) :=
      (localAbsoluteAbelianProfinite X.functionField).group
    let _ : CommGroup (TopologicalAbelianization
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField)))) :=
      TopologicalAbelianization.commGroup
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField)))
    let _ : Algebra k X.functionField := (baseToFunctionField c).toAlgebra
    ∀ [Algebra (RatFunc k) X.functionField]
      [IsScalarTower k (RatFunc k) X.functionField] [FunctionField k X.functionField]
      [HasPrincipalDivisors k X.functionField]
      (m : RayClass.Modulus k X.functionField),
      (∀ v ∈ curveInteriorPlaces c, m v = 0) →
      (curveAbelianizationMap X).toMonoidHom.ker ≤ RayClass.artinRaySubgroup m := by
  intro absoluteGroup targetGroup baseAlgebra rationalAlgebra rationalTower functionField
    principalDivisors m hm
  let f : Gal(SeparableClosure X.functionField/X.functionField) →ₜ*
      π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField)) :=
    genericAbsoluteGaloisHom X
  have hf : Function.Surjective f := genericAbsoluteGaloisHom_surjective X
  have sourceLaw :=
    @genericAbsoluteGaloisHom_ker_image_le_artinRaySubgroup
      k ‹Field k› ‹Finite k› X ‹IsIntegral X› ‹IsNormalIntegral X› c
      ‹SmoothOfRelativeDimension 1 c›
  have sourceLawAtInstances :=
    @sourceLaw rationalAlgebra rationalTower functionField principalDivisors
  have sourceLawAtModulus := sourceLawAtInstances m
  have hsourceInferred := sourceLawAtModulus hm
  have hsource : f.toMonoidHom.ker.map
      (localAbsoluteAbelianizationQuotientMap X.functionField) ≤
        RayClass.artinRaySubgroup m := by
    nyll_kernel_exact hsourceInferred
  exact absoluteAbelianMap_ker_le_artinRaySubgroup (k := k) (K := X.functionField)
    (G := π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField)))
    f hf m hsource

/-- The original global Artin map followed by the abelianization of the
original curve's generic absolute Galois map. -/
def curveArtin {k : Type v} [Field k] [Finite k]
    (X : Scheme.{u}) [IsIntegral X] [Algebra k X.functionField]
    [Algebra (RatFunc k) X.functionField] [IsScalarTower k (RatFunc k) X.functionField]
    [FunctionField k X.functionField] [HasPrincipalDivisors k X.functionField] :
    let _ : CommGroup (IdeleClassGroup k X.functionField) :=
      RayClass.powerRayIdeleClassCommGroup (k := k) (K := X.functionField)
    IdeleClassGroup k X.functionField →ₜ*
      TopologicalAbelianization
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField))) := by
  intro ideleClassGroup
  exact absoluteArtinComp (k := k) (K := X.functionField) (curveAbelianizationMap X)

/-- Every relation in the actual curve Artin map satisfies every native
ray congruence supported outside the original curve. -/
theorem curveArtin_ker_le_rayClassSubgroup
    {k : Type u} [Field k] [Finite k] {X : Scheme.{u}}
    [IsIntegral X] [IsNormalIntegral X]
    (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c] :
    let _ : CommGroup (TopologicalAbelianization
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField)))) :=
      TopologicalAbelianization.commGroup
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField)))
    let _ : Algebra k X.functionField := (baseToFunctionField c).toAlgebra
    ∀ [Algebra (RatFunc k) X.functionField]
      [IsScalarTower k (RatFunc k) X.functionField] [FunctionField k X.functionField]
      [HasPrincipalDivisors k X.functionField],
    let _ : CommGroup (IdeleClassGroup k X.functionField) :=
      RayClass.powerRayIdeleClassCommGroup (k := k) (K := X.functionField)
    ∀ (m : RayClass.Modulus k X.functionField),
      (∀ v ∈ curveInteriorPlaces c, m v = 0) →
      (curveArtin (k := k) X).toMonoidHom.ker ≤ RayClass.rayClassSubgroup m := by
  intro targetGroup baseAlgebra rationalAlgebra rationalTower functionField principalDivisors
    ideleClassGroup m hm
  let f : localAbsoluteAbelianProfinite X.functionField →ₜ*
      TopologicalAbelianization
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField))) :=
    curveAbelianizationMap X
  have hkernel : f.toMonoidHom.ker ≤ RayClass.artinRaySubgroup m := by
    nyll_kernel_exact
      (curveAbelianizationMap_ker_le_artinRaySubgroup (k := k) (X := X) c m hm)
  nyll_kernel_exact
    (absoluteArtinComp_ker_le_rayClassSubgroup (k := k) (K := X.functionField)
      (G := TopologicalAbelianization
        (π₁ᵉᵗ(X.genericExtensionMorphism (AlgebraicClosure X.functionField))))
      f m hkernel)

end EtaleFundamentalGroups.Inertia
