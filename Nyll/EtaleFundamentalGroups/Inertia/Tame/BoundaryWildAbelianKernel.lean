/-!
# The original absolute map to the boundary-wild abelian quotient

The actual generic absolute Galois map followed by the original boundary-wild
projection is a continuous surjection. Its abelianized kernel is computed
inside the original absolute abelianization: it is the closed subgroup
generated by the actual generic-kernel image and the actual boundary wild
images, before passing to the fundamental group.

All normalization rings, primes, wild groups, and maps come from the given
generic field source. No comparison with a ray class quotient is assumed.
-/

@[expose] public section

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open CategoryTheory.PreGaloisCategory TopologicalSpace SchemeTheory NeronModelInfra

namespace EtaleFundamentalGroups.Tame

universe u v w

private theorem comap_closedNormalClosure_image
    {G : Type v} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
    {H : Type w} [Group H] [TopologicalSpace H] [IsTopologicalGroup H] [T2Space H]
    (q : G →ₜ* H) (hq : Function.Surjective q) (s : Set G) :
    ((Subgroup.normalClosure (q '' s)).topologicalClosure).comap q.toMonoidHom =
      (Subgroup.normalClosure ((q.toMonoidHom.ker : Set G) ∪ s)).topologicalClosure := by
  let N : Subgroup G :=
    (Subgroup.normalClosure ((q.toMonoidHom.ker : Set G) ∪ s)).topologicalClosure
  let W : Subgroup H := (Subgroup.normalClosure (q '' s)).topologicalClosure
  have hNnormal : N.Normal := Subgroup.is_normal_topologicalClosure _
  have hWnormal : W.Normal := Subgroup.is_normal_topologicalClosure _
  have hNclosed : IsClosed (N : Set G) := Subgroup.isClosed_topologicalClosure _
  have hWclosed : IsClosed (W : Set H) := Subgroup.isClosed_topologicalClosure _
  have hker : q.toMonoidHom.ker ≤ N := by
    intro g hg
    exact (Subgroup.le_topologicalClosure _)
      (Subgroup.subset_normalClosure (Or.inl hg))
  have himageNormal : (N.map q.toMonoidHom).Normal := by
    constructor
    rintro x ⟨g, hg, rfl⟩ y
    obtain ⟨z, rfl⟩ := hq y
    refine ⟨z * g * z⁻¹, hNnormal.conj_mem g hg z, ?_⟩
    calc
      q.toMonoidHom (z * g * z⁻¹) =
          q.toMonoidHom (z * g) * q.toMonoidHom (z⁻¹) :=
        map_mul q.toMonoidHom (z * g) (z⁻¹)
      _ = (q.toMonoidHom z * q.toMonoidHom g) * (q.toMonoidHom z)⁻¹ :=
        congrArg₂ (· * ·) (map_mul q.toMonoidHom z g) (map_inv q.toMonoidHom z)
      _ = q z * q.toMonoidHom g * (q z)⁻¹ := rfl
  have himageClosed : IsClosed (N.map q.toMonoidHom : Set H) :=
    (hNclosed.isCompact.image q.continuous_toFun).isClosed
  have hWimage : W ≤ N.map q.toMonoidHom := by
    apply Subgroup.topologicalClosure_minimal
    · apply Subgroup.normalClosure_le_normal
      rintro x ⟨g, hg, rfl⟩
      exact ⟨g, (Subgroup.le_topologicalClosure _)
        (Subgroup.subset_normalClosure (Or.inr hg)), rfl⟩
    · exact himageClosed
  have hNW : N ≤ W.comap q.toMonoidHom := by
    apply Subgroup.topologicalClosure_minimal
    · apply Subgroup.normalClosure_le_normal
      intro g hg
      rcases hg with hg | hg
      · change q g ∈ W
        have hqg : q g = 1 := MonoidHom.mem_ker.mp hg
        rw [hqg]
        exact W.one_mem
      · exact (Subgroup.le_topologicalClosure _)
          (Subgroup.subset_normalClosure ⟨g, hg, rfl⟩)
    · exact hWclosed.preimage q.continuous_toFun
  change W.comap q.toMonoidHom = N
  apply le_antisymm
  · intro g hg
    obtain ⟨z, hz, hzg⟩ := hWimage hg
    change q z = q g at hzg
    have hquot : z⁻¹ * g ∈ q.toMonoidHom.ker := by
      change q (z⁻¹ * g) = 1
      rw [map_mul, map_inv, hzg, inv_mul_cancel]
    have hproduct := N.mul_mem hz (hker hquot)
    simpa only [mul_inv_cancel_left] using hproduct
  · exact hNW

attribute [local instance] integralOpenDominant

attribute [local instance] Inertia.normalizationCommAlgGaloisAction

variable (k F Ω : Type u) [Field k] [Field F] [Field Ω]
    [Algebra F Ω] [IsSepClosure F Ω] [IsSepClosed Ω]
    {X U : Scheme.{u}} [IsIntegral X] [IsIntegral U]
    (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c]
    (j : U ⟶ X) [IsOpenImmersion j]
    (p : Spec (.of F) ⟶ U) [IsDominant p] [IsPreimmersion p]

local notation "G" => Gal(Ω/F)
local notation "Ab" => ProCGroups.Abelian.TopologicalAbelianization.mk

/-- The same native normalization wild groups as in the boundary quotient,
with their literal images in the original absolute Galois group. -/
def absoluteNormalizationWildImageAt (x : X) (hx : IsClosed ({x} : Set X)) :
    Subgroup G := by
  let A := X.presheaf.stalk x
  have : IsDiscreteValuationRing A :=
    SmoothOfRelativeDimension.isDiscreteValuationRing_stalk_of_isClosed c x hx
  let : Algebra A F := genericFieldSourceStalkAlgebra (p ≫ j) x
  have : IsFractionRing A F := genericFieldSourceStalk_isFractionRing (p ≫ j) x
  let : Algebra A Ω := ((algebraMap F Ω).comp (algebraMap A F)).toAlgebra
  have : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
  exact ⨆ Q : MaximalSpectrum (normalizationCommAlgCat A Ω),
    let : Q.asIdeal.IsMaximal := Q.isMaximal
    (Inertia.actualNormalizationWildSubgroup A F Ω Q.asIdeal).map
      (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom'

/-- Applying the original generic map recovers the original wild image
used to define the boundary-wild quotient, at the same point and primes. -/
theorem absoluteNormalizationWildImageAt_map (x : X) (hx : IsClosed ({x} : Set X)) :
    (absoluteNormalizationWildImageAt k F Ω c j p x hx).map
      (fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom =
        normalizationWildImageAt k F Ω c j p x hx := by
  let A := X.presheaf.stalk x
  have : IsDiscreteValuationRing A :=
    SmoothOfRelativeDimension.isDiscreteValuationRing_stalk_of_isClosed c x hx
  let : Algebra A F := genericFieldSourceStalkAlgebra (p ≫ j) x
  have : IsFractionRing A F := genericFieldSourceStalk_isFractionRing (p ≫ j) x
  let : Algebra A Ω := ((algebraMap F Ω).comp (algebraMap A F)).toAlgebra
  have : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
  change (⨆ Q : MaximalSpectrum (normalizationCommAlgCat A Ω),
    let : Q.asIdeal.IsMaximal := Q.isMaximal
    (Inertia.actualNormalizationWildSubgroup A F Ω Q.asIdeal).map
      (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom').map
        (fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom = _
  refine (Subgroup.map_iSup (fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom
    (fun Q : MaximalSpectrum (normalizationCommAlgCat A Ω) =>
      let : Q.asIdeal.IsMaximal := Q.isMaximal
      (Inertia.actualNormalizationWildSubgroup A F Ω Q.asIdeal).map
        (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom')).trans ?_
  apply iSup_congr
  intro Q
  have : Q.asIdeal.IsMaximal := Q.isMaximal
  exact Subgroup.map_map _ _ _

/-- The native boundary wild generators before applying generic monodromy. -/
def absoluteBoundaryWildGenerators : Set G :=
  {σ | ∃ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j ∧
    σ ∈ absoluteNormalizationWildImageAt k F Ω c j p x hx}

/-- The supplied generic map takes the original absolute generators onto
exactly the generators of the original boundary-wild kernel. -/
theorem absoluteBoundaryWildGenerators_image :
    (fieldSourceAbsoluteGaloisHom F Ω p) '' absoluteBoundaryWildGenerators k F Ω c j p =
      boundaryWildGenerators k F Ω c j p := by
  apply Set.ext
  intro γ
  constructor
  · rintro ⟨σ, ⟨x, hx, hboundary, hσ⟩, rfl⟩
    refine ⟨x, hx, hboundary, ?_⟩
    rw [← absoluteNormalizationWildImageAt_map k F Ω c j p x hx]
    exact ⟨σ, hσ, rfl⟩
  · rintro ⟨x, hx, hboundary, hγ⟩
    rw [← absoluteNormalizationWildImageAt_map k F Ω c j p x hx] at hγ
    obtain ⟨σ, hσ, rfl⟩ := hγ
    exact ⟨σ, ⟨x, hx, hboundary, hσ⟩, rfl⟩

/-- The actual absolute map to the original boundary-wild quotient. -/
def boundaryWildAbsoluteHom : G →ₜ* BoundaryWildQuotient k F Ω c j p :=
  (boundaryWildProjection k F Ω c j p).comp (fieldSourceAbsoluteGaloisHom F Ω p)

variable [IsNormalIntegral U]

/-- No additional quotient-surjectivity hypothesis is required: normality
of the actual open curve gives surjectivity of its generic map. -/
theorem boundaryWildAbsoluteHom_surjective :
    Function.Surjective (boundaryWildAbsoluteHom k F Ω c j p) :=
  (boundaryWildProjection_surjective k F Ω c j p).comp
    (fieldSourceAbsoluteGaloisHom_surjective F Ω p)

/-- Before abelianization, the actual composite kills precisely the closed
normal subgroup generated by its original generic kernel and native wild
groups at the original boundary. -/
theorem boundaryWildAbsoluteHom_ker :
    (boundaryWildAbsoluteHom k F Ω c j p).toMonoidHom.ker =
      (Subgroup.normalClosure
        (((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.ker : Set G) ∪
          absoluteBoundaryWildGenerators k F Ω c j p)).topologicalClosure := by
  change (boundaryWildProjection k F Ω c j p).toMonoidHom.ker.comap
    (fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom = _
  rw [boundaryWildProjection_ker, boundaryWildKernel,
    ← absoluteBoundaryWildGenerators_image k F Ω c j p]
  exact comap_closedNormalClosure_image (fieldSourceAbsoluteGaloisHom F Ω p)
    (fieldSourceAbsoluteGaloisHom_surjective F Ω p)
    (absoluteBoundaryWildGenerators k F Ω c j p)

/-- The induced original absolute abelian map. For the canonical separable
closure its source is the same absolute abelian group used by global Artin. -/
def boundaryWildAbsoluteAbelianHom :
    TopologicalAbelianization G →ₜ* TopologicalAbelianization (BoundaryWildQuotient k F Ω c j p) :=
  ProCGroups.Abelian.TopologicalAbelianization.map (boundaryWildAbsoluteHom k F Ω c j p)

omit [IsNormalIntegral U] in
/-- The map retains the original absolute automorphism on representatives. -/
@[simp] theorem boundaryWildAbsoluteAbelianHom_mk (σ : G) :
    boundaryWildAbsoluteAbelianHom k F Ω c j p (Ab G σ) =
      Ab (BoundaryWildQuotient k F Ω c j p)
        (boundaryWildProjection k F Ω c j p (fieldSourceAbsoluteGaloisHom F Ω p σ)) := rfl

/-- The actual original abelian map is surjective. -/
theorem boundaryWildAbsoluteAbelianHom_surjective :
    Function.Surjective (boundaryWildAbsoluteAbelianHom k F Ω c j p) :=
  ProCGroups.Abelian.TopologicalAbelianization.surjective_map_of_surjective
    (boundaryWildAbsoluteHom k F Ω c j p) (boundaryWildAbsoluteHom_surjective k F Ω c j p)

/-- The exact abelianized kernel, expressed only using the original generic
kernel and original boundary wild groups in the original absolute group.
Compactness accounts for every closure in this equality. -/
theorem boundaryWildAbsoluteAbelianHom_ker :
    (boundaryWildAbsoluteAbelianHom k F Ω c j p).toMonoidHom.ker =
      (((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.ker.map (Ab G)) ⊔
        (⨆ (x : X) (hx : IsClosed ({x} : Set X)) (_ : x ∉ Set.range j),
          (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G))).topologicalClosure := by
  let q := fieldSourceAbsoluteGaloisHom F Ω p
  let s := absoluteBoundaryWildGenerators k F Ω c j p
  let N : Subgroup G :=
    (Subgroup.normalClosure ((q.toMonoidHom.ker : Set G) ∪ s)).topologicalClosure
  let W : Subgroup (TopologicalAbelianization G) :=
    (q.toMonoidHom.ker.map (Ab G)) ⊔
      (⨆ (x : X) (hx : IsClosed ({x} : Set X)) (_ : x ∉ Set.range j),
        (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G))
  change (ProCGroups.Abelian.TopologicalAbelianization.map
    (boundaryWildAbsoluteHom k F Ω c j p)).toMonoidHom.ker = _
  rw [ProCGroups.Abelian.TopologicalAbelianization.ker_map_of_surjective
    (boundaryWildAbsoluteHom k F Ω c j p) (boundaryWildAbsoluteHom_surjective k F Ω c j p),
    boundaryWildAbsoluteHom_ker]
  change N.map (Ab G) = W.topologicalClosure
  have hNclosed : IsClosed (N : Set G) := Subgroup.isClosed_topologicalClosure _
  have hmapClosed : IsClosed (N.map (Ab G) : Set (TopologicalAbelianization G)) :=
    (hNclosed.isCompact.image
      (ProCGroups.Abelian.TopologicalAbelianization.mkₜ G).continuous_toFun).isClosed
  apply le_antisymm
  · have hN : N ≤ W.topologicalClosure.comap (Ab G) := by
      apply Subgroup.topologicalClosure_minimal
      · apply Subgroup.normalClosure_le_normal
        intro σ hσ
        apply Subgroup.le_topologicalClosure W
        rcases hσ with hσ | hσ
        · exact (show q.toMonoidHom.ker.map (Ab G) ≤ W from le_sup_left)
            ⟨σ, hσ, rfl⟩
        · obtain ⟨x, hx, hboundary, hσ⟩ := hσ
          have hle : (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G) ≤ W := by
            dsimp only [W]
            exact (le_iSup_of_le
              (f := fun y : X => ⨆ (hy : IsClosed ({y} : Set X)) (_ : y ∉ Set.range j),
                (absoluteNormalizationWildImageAt k F Ω c j p y hy).map (Ab G)) x
              (le_iSup_of_le
                (f := fun hy : IsClosed ({x} : Set X) => ⨆ (_ : x ∉ Set.range j),
                  (absoluteNormalizationWildImageAt k F Ω c j p x hy).map (Ab G)) hx
                (le_iSup_of_le
                  (f := fun _ : x ∉ Set.range j =>
                    (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G))
                  hboundary le_rfl))).trans le_sup_right
          exact hle ⟨σ, hσ, rfl⟩
      · exact (Subgroup.isClosed_topologicalClosure W).preimage
          (ProCGroups.Abelian.TopologicalAbelianization.mkₜ G).continuous_toFun
    rintro a ⟨σ, hσ, rfl⟩
    exact hN hσ
  · apply Subgroup.topologicalClosure_minimal
    · apply sup_le
      · rintro a ⟨σ, hσ, rfl⟩
        exact ⟨σ, (Subgroup.le_topologicalClosure _)
          (Subgroup.subset_normalClosure (Or.inl hσ)), rfl⟩
      · apply iSup_le
        intro x
        apply iSup_le
        intro hx
        apply iSup_le
        intro hboundary
        rintro a ⟨σ, hσ, rfl⟩
        exact ⟨σ, (Subgroup.le_topologicalClosure _)
          (Subgroup.subset_normalClosure (Or.inr ⟨x, hx, hboundary, hσ⟩)), rfl⟩
    · exact hmapClosed

/-- The native closed ramification subgroup gives an actual topological
quotient presentation of the original boundary-wild abelian fundamental
group. The defining subgroup is constructed from the original local data. -/
def boundaryWildAbsoluteAbelianQuotientEquiv :
    (TopologicalAbelianization G ⧸
      (((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.ker.map (Ab G)) ⊔
        (⨆ (x : X) (hx : IsClosed ({x} : Set X)) (_ : x ∉ Set.range j),
          (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G))).topologicalClosure) ≃ₜ*
      TopologicalAbelianization (BoundaryWildQuotient k F Ω c j p) := by
  let N : Subgroup (TopologicalAbelianization G) :=
    (((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.ker.map (Ab G)) ⊔
      (⨆ (x : X) (hx : IsClosed ({x} : Set X)) (_ : x ∉ Set.range j),
        (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G))).topologicalClosure
  let f := boundaryWildAbsoluteAbelianHom k F Ω c j p
  have hker : f.toMonoidHom.ker = N := boundaryWildAbsoluteAbelianHom_ker k F Ω c j p
  let lift := ProCGroups.QuotientGroup.liftₜ N f hker.symm.le
  apply ProCGroups.ContinuousMulEquiv.ofBijectiveCompactToT2
    lift.toMonoidHom lift.continuous_toFun
  constructor
  · apply (QuotientGroup.injective_lift_iff N f.toMonoidHom hker.symm.le).mpr
    exact hker.symm
  · intro a
    obtain ⟨σ, hσ⟩ := boundaryWildAbsoluteAbelianHom_surjective k F Ω c j p a
    exact ⟨QuotientGroup.mk' N σ, hσ⟩

/-- The quotient presentation sends every original absolute automorphism
to its original generic image in the boundary-wild abelian quotient. -/
@[simp] theorem boundaryWildAbsoluteAbelianQuotientEquiv_mk (σ : G) :
    boundaryWildAbsoluteAbelianQuotientEquiv k F Ω c j p
      (QuotientGroup.mk'
        (((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.ker.map (Ab G) ⊔
          (⨆ (x : X) (hx : IsClosed ({x} : Set X)) (_ : x ∉ Set.range j),
            (absoluteNormalizationWildImageAt k F Ω c j p x hx).map (Ab G))).topologicalClosure)
        (Ab G σ)) =
      Ab (BoundaryWildQuotient k F Ω c j p)
        (boundaryWildProjection k F Ω c j p (fieldSourceAbsoluteGaloisHom F Ω p σ)) := rfl

end EtaleFundamentalGroups.Tame
