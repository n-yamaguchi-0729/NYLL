/-!
# The original boundary-wild quotient

At every closed point outside the original open curve, use the actual local
ring, its integral closure in the chosen generic separable closure, and every
maximal prime of that integral closure. The quotient kills exactly the closed
normal subgroup generated by the images of their native wild inertia groups.

This construction supplies the original arithmetic projection and a continuous
quotient universal property. An equivalence with a category of tamely ramified
covers is a separate statement and is not assumed here.
-/

@[expose] public section

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open CategoryTheory.PreGaloisCategory TopologicalSpace SchemeTheory NeronModelInfra

namespace EtaleFundamentalGroups.Tame

universe u v

local instance integralOpenDominant
    {X U : Scheme.{u}} [IsIntegral X] [IsIntegral U]
    (j : U ⟶ X) [IsOpenImmersion j] : IsDominant j :=
  ⟨j.isOpenEmbedding.isOpenMap.denseRange_of_isPreirreducibleSpace j⟩

attribute [local instance] Inertia.normalizationCommAlgGaloisAction

variable (k F Ω : Type u) [Field k] [Field F] [Field Ω]
  [Algebra F Ω] [IsSepClosure F Ω] [IsSepClosed Ω]
  {X U : Scheme.{u}} [IsIntegral X] [IsIntegral U]
  (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c]
  (j : U ⟶ X) [IsOpenImmersion j]
  (p : Spec (.of F) ⟶ U) [IsDominant p] [IsPreimmersion p]

local notation "Π" => π₁ᵉᵗ(ξ F Ω ≫ p)

/-- The native wild inertia images at one actual closed point. All local
coefficient structures come from the original generic field source. -/
def normalizationWildImageAt (x : X) (hx : IsClosed ({x} : Set X)) : Subgroup Π := by
  let A := X.presheaf.stalk x
  have : IsDiscreteValuationRing A :=
    SmoothOfRelativeDimension.isDiscreteValuationRing_stalk_of_isClosed c x hx
  let : Algebra A F := genericFieldSourceStalkAlgebra (p ≫ j) x
  have : IsFractionRing A F := genericFieldSourceStalk_isFractionRing (p ≫ j) x
  let : Algebra A Ω := ((algebraMap F Ω).comp (algebraMap A F)).toAlgebra
  have : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
  exact ⨆ Q : MaximalSpectrum (normalizationCommAlgCat A Ω),
    let : Q.asIdeal.IsMaximal := Q.isMaximal
    (Inertia.actualNormalizationWildSubgroup A F Ω Q.asIdeal).map
      ((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.comp
        (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom')

/-- Generators use only the original closed boundary, and every native
normalization prime above each of those points. -/
def boundaryWildGenerators : Set Π :=
  {γ | ∃ (x : X) (hx : IsClosed ({x} : Set X)),
    x ∉ Set.range j ∧ γ ∈ normalizationWildImageAt k F Ω c j p x hx}

/-- The closed normal subgroup generated by the original boundary wild
inertia images. It does not remove the whole geometric p-primary part. -/
def boundaryWildKernel : Subgroup Π :=
  (Subgroup.normalClosure (boundaryWildGenerators k F Ω c j p)).topologicalClosure

instance boundaryWildKernel_normal : (boundaryWildKernel k F Ω c j p).Normal :=
  Subgroup.is_normal_topologicalClosure _

/-- The defining subgroup is closed in the original fundamental group. -/
theorem boundaryWildKernel_isClosed :
    IsClosed (boundaryWildKernel k F Ω c j p : Set Π) :=
  Subgroup.isClosed_topologicalClosure _

/-- The actual original boundary-wild quotient. -/
abbrev BoundaryWildQuotient := Π ⧸ boundaryWildKernel k F Ω c j p

instance boundaryWildQuotient_t2Space : T2Space (BoundaryWildQuotient k F Ω c j p) := by
  have : IsClosed (boundaryWildKernel k F Ω c j p : Set Π) :=
    boundaryWildKernel_isClosed k F Ω c j p
  infer_instance

instance boundaryWildQuotient_totallyDisconnectedSpace :
    TotallyDisconnectedSpace (BoundaryWildQuotient k F Ω c j p) :=
  ProCGroups.totallyDisconnectedSpace_quotient_closedNormal
    (boundaryWildKernel k F Ω c j p) (boundaryWildKernel_isClosed k F Ω c j p)

/-- The quotient projection retains the original fundamental-group representatives. -/
def boundaryWildProjection : Π →ₜ* BoundaryWildQuotient k F Ω c j p :=
  { toMonoidHom := QuotientGroup.mk' (boundaryWildKernel k F Ω c j p)
    continuous_toFun := QuotientGroup.continuous_mk }

/-- The original projection is surjective. -/
theorem boundaryWildProjection_surjective :
    Function.Surjective (boundaryWildProjection k F Ω c j p) :=
  QuotientGroup.mk'_surjective _

/-- Its kernel is exactly the closed normal subgroup of boundary wild images. -/
theorem boundaryWildProjection_ker :
    (boundaryWildProjection k F Ω c j p).toMonoidHom.ker =
      boundaryWildKernel k F Ω c j p :=
  QuotientGroup.ker_mk' _

/-- A continuous homomorphism to a Hausdorff group kills the entire closed
normal subgroup precisely when it kills each original boundary wild image. -/
theorem boundaryWildKernel_le_ker_iff
    {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : Π →ₜ* H) :
    boundaryWildKernel k F Ω c j p ≤ q.toMonoidHom.ker ↔
      ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
        ∀ γ ∈ normalizationWildImageAt k F Ω c j p x hx, q γ = 1 := by
  constructor
  · intro h x hx hboundary γ hγ
    exact h ((Subgroup.le_topologicalClosure _)
      (Subgroup.subset_normalClosure ⟨x, hx, hboundary, hγ⟩))
  · intro h
    apply Subgroup.topologicalClosure_minimal
    · apply Subgroup.normalClosure_le_normal
      rintro γ ⟨x, hx, hboundary, hγ⟩
      exact h x hx hboundary γ hγ
    · exact isClosed_eq q.continuous_toFun continuous_const

/-- The continuous factor through the actual quotient, for the exact
original killing condition. In particular this applies to finite quotients. -/
def boundaryWildLift
    {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : Π →ₜ* H)
    (hq : ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
      ∀ γ ∈ normalizationWildImageAt k F Ω c j p x hx, q γ = 1) :
    BoundaryWildQuotient k F Ω c j p →ₜ* H :=
  ProCGroups.QuotientGroup.liftₜ (boundaryWildKernel k F Ω c j p) q
    ((boundaryWildKernel_le_ker_iff k F Ω c j p q).mpr hq)

/-- The factor is the original homomorphism on every representative. -/
@[simp] theorem boundaryWildLift_projection
    {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : Π →ₜ* H)
    (hq : ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
      ∀ γ ∈ normalizationWildImageAt k F Ω c j p x hx, q γ = 1) (γ : Π) :
    boundaryWildLift k F Ω c j p q hq (boundaryWildProjection k F Ω c j p γ) = q γ :=
  rfl

/-- In particular, a finite continuous quotient factors through the original
boundary-wild quotient exactly when every native boundary wild image is killed.
The same criterion holds for any Hausdorff target group. -/
theorem exists_boundaryWildLift_iff
    {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : Π →ₜ* H) :
    (∃ qbar : BoundaryWildQuotient k F Ω c j p →ₜ* H,
      qbar.comp (boundaryWildProjection k F Ω c j p) = q) ↔
      ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
        ∀ γ ∈ normalizationWildImageAt k F Ω c j p x hx, q γ = 1 := by
  constructor
  · rintro ⟨qbar, hq⟩
    apply (boundaryWildKernel_le_ker_iff k F Ω c j p q).mp
    intro γ hγ
    have hproj : boundaryWildProjection k F Ω c j p γ = 1 :=
      (QuotientGroup.eq_one_iff γ).mpr hγ
    change q γ = 1
    calc
      q γ = qbar (boundaryWildProjection k F Ω c j p γ) :=
        (DFunLike.congr_fun hq γ).symm
      _ = 1 := by rw [hproj, map_one]
  · intro hq
    refine ⟨boundaryWildLift k F Ω c j p q hq, ?_⟩
    apply ContinuousMonoidHom.ext
    intro γ
    rfl

/-- A factor retaining the original representatives is unique. -/
theorem boundaryWildLift_unique
    {H : Type v} [Group H] [TopologicalSpace H]
    (q₁ q₂ : BoundaryWildQuotient k F Ω c j p →ₜ* H)
    (h : q₁.comp (boundaryWildProjection k F Ω c j p) =
      q₂.comp (boundaryWildProjection k F Ω c j p)) : q₁ = q₂ := by
  apply ContinuousMonoidHom.ext
  intro x
  obtain ⟨γ, rfl⟩ := boundaryWildProjection_surjective k F Ω c j p x
  exact DFunLike.congr_fun h γ

section Arithmetic

variable (κ : Type u) [Field κ] [Algebra k F] [Algebra k κ] [Algebra k Ω]
  [Algebra κ Ω] [IsScalarTower k F Ω] [IsScalarTower k κ Ω]
  [IsAlgClosure k κ] [IsSepClosure k κ]
  (hp : (p ≫ j) ≫ c = Spec.map (CommRingCat.ofHom (algebraMap k F)))

omit [IsSepClosure F Ω] [IsSepClosed Ω] [IsIntegral X] [IsIntegral U]
  [SmoothOfRelativeDimension 1 c] [IsOpenImmersion j] [IsDominant p] [IsPreimmersion p] in
include hp in
private theorem genericPoint_over_base :
    (ξ F Ω ≫ p) ≫ (j ≫ c) = ξ k Ω := by
  calc
    (ξ F Ω ≫ p) ≫ (j ≫ c) = ξ F Ω ≫ ((p ≫ j) ≫ c) := by
      simp only [Category.assoc]
    _ = ξ F Ω ≫ Spec.map (CommRingCat.ofHom (algebraMap k F)) :=
      congrArg (fun f => ξ F Ω ≫ f) hp
    _ = ξ k Ω := by
      rw [← Spec.map_comp]
      exact congrArg (fun f : k →+* Ω => Spec.map (CommRingCat.ofHom f))
        (IsScalarTower.algebraMap_eq k F Ω).symm

include hp in
/-- The original native wild image at every closed point has trivial
arithmetic projection. The point need not be rational. -/
theorem normalizationWildImageAt_le_arithmetic_ker
    (x : X) (hx : IsClosed ({x} : Set X)) :
    normalizationWildImageAt k F Ω c j p x hx ≤
      (arithmeticFundamentalGroupHom k κ (j ≫ c) (ξ F Ω ≫ p)).toMonoidHom.ker := by
  let A := X.presheaf.stalk x
  have : IsDiscreteValuationRing A :=
    SmoothOfRelativeDimension.isDiscreteValuationRing_stalk_of_isClosed c x hx
  let : Algebra A F := genericFieldSourceStalkAlgebra (p ≫ j) x
  have : IsFractionRing A F := genericFieldSourceStalk_isFractionRing (p ≫ j) x
  let : Algebra A Ω := ((algebraMap F Ω).comp (algebraMap A F)).toAlgebra
  have : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
  let : Algebra k A := stalkAlgebra c x
  have : IsScalarTower k A F := genericFieldSourceStalk_isScalarTower (p ≫ j) x c hp
  have : IsScalarTower k A Ω := IsScalarTower.to₁₂₄ k A F Ω
  change (⨆ Q : MaximalSpectrum (normalizationCommAlgCat A Ω),
    let : Q.asIdeal.IsMaximal := Q.isMaximal
    (Inertia.actualNormalizationWildSubgroup A F Ω Q.asIdeal).map
      ((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.comp
        (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom')) ≤ _
  apply iSup_le
  intro Q
  have : Q.asIdeal.IsMaximal := Q.isMaximal
  rintro γ ⟨σ, _, rfl⟩
  exact Inertia.normalizationInertia_fieldSource_arithmetic_eq_one k A F κ Ω Q.asIdeal
    (j ≫ c) p (genericPoint_over_base k F Ω c j p hp) σ.val σ.property

/-- The original arithmetic projection descends to the boundary-wild quotient. -/
def boundaryWildArithmeticProjection : BoundaryWildQuotient k F Ω c j p →ₜ* Gal(κ/k) :=
  boundaryWildLift k F Ω c j p
    (arithmeticFundamentalGroupHom k κ (j ≫ c) (ξ F Ω ≫ p))
    (fun x hx _ _γ hγ => normalizationWildImageAt_le_arithmetic_ker
      k F Ω c j p κ hp x hx hγ)

/-- Descent retains the exact original arithmetic label. -/
@[simp] theorem boundaryWildArithmeticProjection_apply_projection (γ : Π) :
    boundaryWildArithmeticProjection k F Ω c j p κ hp
      (boundaryWildProjection k F Ω c j p γ) =
        arithmeticFundamentalGroupHom k κ (j ≫ c) (ξ F Ω ≫ p) γ := rfl

end Arithmetic

end EtaleFundamentalGroups.Tame
