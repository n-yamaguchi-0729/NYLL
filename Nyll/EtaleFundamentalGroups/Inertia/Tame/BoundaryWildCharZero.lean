module

public import Nyll.EtaleFundamentalGroups.Inertia.Tame.BoundaryWildQuotient
public import Nyll.EtaleFundamentalGroups.Inertia.ActualNormalizationWildCharZero
public import Nyll.ProCGroups.Topologies.ContinuousMulEquiv
public import Mathlib.Algebra.CharP.Algebra

/-!
# The boundary-wild projection over a characteristic-zero field

The structural morphism embeds the constant field into the residue field of
every closed-point stalk. Native wild inertia therefore vanishes at each
boundary point. The existing boundary-wild projection is consequently a
continuous equivalence, retaining its original fundamental-group representatives.
-/

@[expose] public section

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale
open CategoryTheory.PreGaloisCategory TopologicalSpace SchemeTheory NeronModelInfra

namespace EtaleFundamentalGroups.Tame

universe u

attribute [local instance] Inertia.normalizationCommAlgGaloisAction integralOpenDominant

variable (k F Ω : Type u) [Field k] [CharZero k] [Field F] [Field Ω]
  [Algebra F Ω] [IsSepClosure F Ω] [IsSepClosed Ω]
  {X U : Scheme.{u}} [IsIntegral X] [IsIntegral U]
  (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c]
  (j : U ⟶ X) [IsOpenImmersion j]
  (p : Spec (.of F) ⟶ U) [IsDominant p] [IsPreimmersion p]

local notation "Π" => π₁ᵉᵗ(ξ F Ω ≫ p)

/-- Every actual normalization wild image vanishes over a characteristic-zero
base field; the residue characteristic is supplied by the structure morphism. -/
theorem normalizationWildImageAt_eq_bot_of_charZero
    (x : X) (hx : IsClosed ({x} : Set X)) :
    normalizationWildImageAt k F Ω c j p x hx = ⊥ := by
  have : IsDominant j :=
    ⟨j.isOpenEmbedding.isOpenMap.denseRange_of_isPreirreducibleSpace j⟩
  let A := X.presheaf.stalk x
  have : IsDiscreteValuationRing A :=
    SmoothOfRelativeDimension.isDiscreteValuationRing_stalk_of_isClosed c x hx
  let : Algebra A F := genericFieldSourceStalkAlgebra (p ≫ j) x
  have : IsFractionRing A F := genericFieldSourceStalk_isFractionRing (p ≫ j) x
  let : Algebra A Ω := ((algebraMap F Ω).comp (algebraMap A F)).toAlgebra
  have : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
  let : Algebra k A := stalkAlgebra c x
  have : CharZero (IsLocalRing.ResidueField A) :=
    charZero_of_injective_ringHom
      ((IsLocalRing.residue A).comp (algebraMap k A)).injective
  change (⨆ Q : MaximalSpectrum (normalizationCommAlgCat A Ω),
    let : Q.asIdeal.IsMaximal := Q.isMaximal
    (Inertia.actualNormalizationWildSubgroup A F Ω Q.asIdeal).map
      ((fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.comp
        (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom')) = ⊥
  apply le_antisymm ?_ bot_le
  apply iSup_le
  intro Q
  have : Q.asIdeal.IsMaximal := Q.isMaximal
  let f := (fieldSourceAbsoluteGaloisHom F Ω p).toMonoidHom.comp
    (Inertia.actualNormalizationInertiaInclusion A F Ω Q.asIdeal).hom'
  have h := Inertia.actualNormalizationWildSubgroup_eq_bot_of_baseResidue_charZero
    A F Ω Q.asIdeal
  exact ((congrArg (fun H => H.map f) h).trans (Subgroup.map_bot f)).le

/-- In characteristic zero the original closed normal subgroup generated by
boundary wild inertia is trivial, without a rationality assumption on the boundary. -/
theorem boundaryWildKernel_eq_bot_of_charZero :
    boundaryWildKernel k F Ω c j p = ⊥ := by
  apply le_antisymm ?_ bot_le
  change (Subgroup.normalClosure (boundaryWildGenerators k F Ω c j p)).topologicalClosure ≤ ⊥
  apply Subgroup.topologicalClosure_minimal
  · apply Subgroup.normalClosure_le_normal
    rintro γ ⟨x, hx, _, hγ⟩
    rwa [normalizationWildImageAt_eq_bot_of_charZero k F Ω c j p x hx] at hγ
  · exact isClosed_singleton

/-- The existing boundary-wild projection is bijective in characteristic zero. -/
theorem boundaryWildProjection_bijective_of_charZero :
    Function.Bijective (boundaryWildProjection k F Ω c j p) := by
  refine ⟨?_, boundaryWildProjection_surjective k F Ω c j p⟩
  apply (MonoidHom.ker_eq_bot_iff _).mp
  rw [boundaryWildProjection_ker, boundaryWildKernel_eq_bot_of_charZero]

/-- The original boundary-wild quotient is continuously isomorphic to the
original étale fundamental group through its actual quotient projection. -/
def boundaryWildProjectionEquivOfCharZero :
    Π ≃ₜ* BoundaryWildQuotient k F Ω c j p :=
  ProCGroups.ContinuousMulEquiv.ofBijectiveCompactToT2
    (boundaryWildProjection k F Ω c j p).toMonoidHom
    (boundaryWildProjection k F Ω c j p).continuous_toFun
    (boundaryWildProjection_bijective_of_charZero k F Ω c j p)

/-- The characteristic-zero comparison retains each original representative. -/
@[simp] theorem boundaryWildProjectionEquivOfCharZero_apply (γ : Π) :
    boundaryWildProjectionEquivOfCharZero k F Ω c j p γ =
      boundaryWildProjection k F Ω c j p γ := rfl

/-- Returning from the quotient recovers the same original representative. -/
@[simp] theorem boundaryWildProjectionEquivOfCharZero_symm_projection (γ : Π) :
    (boundaryWildProjectionEquivOfCharZero k F Ω c j p).symm
      (boundaryWildProjection k F Ω c j p γ) = γ :=
  (boundaryWildProjectionEquivOfCharZero k F Ω c j p).symm_apply_apply γ

end EtaleFundamentalGroups.Tame
