/-!
# Normalization at the actual root divisor

Let `p` be a prime element of a regular domain `R`, and let `L` be a
finite separable extension of the fraction field of `R_(p)`. Suppose
that the residue field at `(p)` has characteristic zero. Adjoin the
factorial-degree root of `p` on the original ring `R`, and localize this
actual root chart at the prime generated by the root.

The normalization of that local ring in the full generic tensor product
is finite étale. The root chart and its localization are the literal
polynomial quotient and prime localization. Their comparison with the
root extension of `R_(p)`, the comparison of fraction fields, and the
comparison of normalizations are constructed in the proof.

There is no restriction on the dimension of `R`. This is the boundary
localization step used before purity in Stacks Project, Proposition
58.30.2: https://stacks.math.columbia.edu/tag/0C0Q.
-/

noncomputable section

open Polynomial
open scoped TensorProduct

namespace EtaleFundamentalGroups.Kummer

universe uR uL

/-- The normalization at the actual root divisor is finite étale after
the factorial-degree root of a prime parameter. The ramification bound
and all local root comparisons are supplied internally. -/
theorem finiteEtale_rootDivisorFactorial_normalization
    (R : Type uR) [CommRing R] [IsDomain R] [IsRegularRing R]
    (p : R) (hp : Prime p) (L : Type uL) :
    let P := Ideal.span ({p} : Set R)
    let : P.IsPrime := Ideal.isPrime_span_singleton_of_prime hp
    let V := Localization.AtPrime P
    let K := FractionRing V
    ∀ [Field L] [Algebra V L] [Algebra K L] [IsScalarTower V K L]
      [FiniteDimensional K L] [Algebra.IsSeparable K L],
      CharZero (V ⧸ IsLocalRing.maximalIdeal V) →
      let n := (Module.finrank K L).factorial
      let D := AdjoinRoot (X ^ n - C p)
      let q := Ideal.span ({AdjoinRoot.root (X ^ n - C p)} : Set D)
      let : q.IsPrime := Ideal.isPrime_span_singleton_of_prime
        (prime_adjoinRoot_root_of_prime (Nat.factorial_pos _) hp)
      let : q.LiesOver P := span_root_liesOver_span_radicand (Nat.factorial_pos _) hp
      let W := Localization.AtPrime q
      let : Algebra V W := Localization.AtPrime.algebraOfLiesOver P q
      let : IsDomain W :=
        adjoinRootLocalizationAtRootPrime_isDomain (Nat.factorial_pos _) hp
      let : IsDiscreteValuationRing W :=
        adjoinRootLocalizationAtRootPrime_isDiscreteValuationRing (Nat.factorial_pos _) hp
      let π := algebraMap R V p
      let Rn := AdjoinRoot (X ^ n - C π)
      let eLocal : Rn ≃ₐ[V] W :=
        adjoinRootLocalizationAtRootPrimeAlgEquiv (Nat.factorial_pos _) hp
      let : Module.Free V Rn := (monic_X_pow_sub_C π (Nat.factorial_pos _).ne').free_adjoinRoot
      let : Module.Free V W := Module.Free.of_equiv eLocal.toLinearEquiv
      let Kroot := FractionRing W
      let : Algebra K Kroot := FractionRing.liftAlgebra V Kroot
      let A := Kroot ⊗[K] L
      let : Algebra W A := genericTensorProductLeftScalarAlgebra
      Module.Finite W (integralClosure W A) ∧ Algebra.Etale W (integralClosure W A) := by
  intro P hP V K hFieldL aVL aKL hVKL hFiniteL hSeparableL hCharZero
    n D q hq hqP W aVW hDomainW hDvrW π Rn eLocal hFreeRn hFreeW Kroot aKKroot A aWA
  have hDvrV : IsDiscreteValuationRing V :=
    isDiscreteValuationRing_localizationAtSpan_of_prime R p hp
  have hπne : π ≠ 0 := by
    intro hzero
    exact hp.ne_zero ((IsLocalization.injective V P.primeCompl_le_nonZeroDivisors)
      (hzero.trans (map_zero (algebraMap R V)).symm))
  have hπspan : IsLocalRing.maximalIdeal V = Ideal.span ({π} : Set V) :=
    localizationAtPrime_maximalIdeal_eq_span_of_eq_span P p rfl
  have hπ : Prime π :=
    (IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal π hπne hπspan).prime
  have : IsDomain Rn :=
    isDomain_adjoinRoot_X_pow_sub_C_of_prime (Nat.factorial_pos _) π hπ
  have : IsDiscreteValuationRing Rn :=
    isDiscreteValuationRing_adjoinRoot_X_pow_sub_C_of_prime (Nat.factorial_pos _) π hπ
  have : Module.FaithfullyFlat V Rn :=
    faithfullyFlat_adjoinRoot_X_pow_sub_C (Nat.factorial_pos _) π
  let F := FractionRing Rn
  let : Algebra K F := FractionRing.liftAlgebra V F
  have : IsScalarTower V K F := FractionRing.isScalarTower_liftAlgebra V F
  have : IsScalarTower V K Kroot := FractionRing.isScalarTower_liftAlgebra V Kroot
  let B := F ⊗[K] L
  let : Algebra Rn B := genericTensorProductLeftScalarAlgebra
  have hEtaleB : Algebra.Etale Rn (integralClosure Rn B) :=
    (finiteEtale_uniformizerFactorialRoot_normalization V L π hπ hCharZero).2.1
  let eField : F ≃ₐ[K] Kroot :=
    IsFractionRing.fieldEquivOfAlgEquiv K F Kroot eLocal
  let eTensor : B ≃ₐ[K] A :=
    Algebra.TensorProduct.congr eField (AlgEquiv.refl : L ≃ₐ[K] L)
  have hmap (r : Rn) :
      eTensor (algebraMap Rn B r) = algebraMap W A (eLocal r) := by
    change eTensor (algebraMap Rn F r ⊗ₜ[K] 1) =
      algebraMap W Kroot (eLocal r) ⊗ₜ[K] 1
    rw [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul, map_one]
    exact congrArg (fun x : Kroot ↦ x ⊗ₜ[K] (1 : L))
      (IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K F Kroot eLocal r)
  have hEtale : Algebra.Etale W (integralClosure W A) := by
    refine integralClosure_etale_of_baseAndAmbientEquiv
      eLocal.symm.toRingEquiv eTensor.symm.toRingEquiv ?_ hEtaleB
    ext w
    change eTensor.symm (algebraMap W A w) = algebraMap Rn B (eLocal.symm w)
    apply eTensor.injective
    rw [AlgEquiv.apply_symm_apply, hmap, AlgEquiv.apply_symm_apply]
  have : Algebra.FinitePresentation W (integralClosure W A) := hEtale.finitePresentation
  have hFiniteType : Algebra.FiniteType W (integralClosure W A) :=
    Algebra.FiniteType.of_finitePresentation (R := W) (A := integralClosure W A)
  exact ⟨Algebra.IsIntegral.finite (R := W) (A := integralClosure W A)
    (h' := hFiniteType), hEtale⟩

end EtaleFundamentalGroups.Kummer
