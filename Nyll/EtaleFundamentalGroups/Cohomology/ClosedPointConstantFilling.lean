/-!
# Filling one chosen closed point after a finite extension of constants

The residue field of the specified closed point is embedded into the fixed
algebraically closed field. Its literal image is a finite constant field,
and its original residue morphism gives a rational point on the actual
constant cover. The filling divisor has that one point as support. The
original filling kernel is generated by the full inertia at the chosen
normalization prime, without filling the other conjugate points.
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.FiniteEtale EtaleFundamentalGroups.Inertia
open EtaleFundamentalGroups.StrictHenselian Yamaguchi26SolvableCoverings

namespace EtaleFundamentalGroups.Cohomology

/-- The selected closed point becomes rational over the literal image of
its residue field in the fixed algebraically closed constant field. -/
theorem exists_closedPoint_finiteConstant_morphism
    (k κ : Type) [Field k] [Field κ] [Algebra k κ] [IsAlgClosed κ]
    {X : Scheme.{0}} (c : X ⟶ Spec (.of k)) [LocallyOfFiniteType c]
    (x : X) (hx : IsClosed ({x} : Set X)) :
    ∃ E : IntermediateField k κ, FiniteDimensional k E ∧
      ∃ p : Spec (.of E) ⟶ X,
        p ≫ c = ξ k E ∧ p (IsLocalRing.closedPoint E) = x := by
  let : Algebra k (X.residueField x) := Scheme.pointResidueAlgebra c x
  have : Module.Finite k (X.residueField x) := Scheme.pointResidueAlgebra_finite c x hx
  let β : X.residueField x →ₐ[k] κ := IsAlgClosed.lift
  let E : IntermediateField k κ := β.fieldRange
  let e : X.residueField x ≃ₐ[k] E := β.equivFieldRange
  have hE : FiniteDimensional k E :=
    Module.Finite.of_surjective e.toLinearMap e.surjective
  let p : Spec (.of E) ⟶ X :=
    Spec.map (CommRingCat.ofHom e.toRingHom) ≫ X.fromSpecResidueField x
  refine ⟨E, hE, p, ?_, ?_⟩
  · change (Spec.map (CommRingCat.ofHom e.toRingHom) ≫
        X.fromSpecResidueField x) ≫ c = ξ k E
    rw [Category.assoc, ← Scheme.pointResidueAlgebra_specMap c x]
    change Spec.map (CommRingCat.ofHom e.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k (X.residueField x))) =
        Spec.map (CommRingCat.ofHom (algebraMap k E))
    rw [← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    exact e.toAlgHom.comp_algebraMap
  · exact Scheme.fromSpecResidueField_apply x _

section ConstantPoint

variable (k E : Type) [Field k] [Field E] [Algebra k E]
  [IsFiniteEtale (Spec.map (CommRingCat.ofHom (algebraMap k E)))]
  {X : Scheme.{0}} (c : X ⟶ Spec (.of k))
  (p : Spec (.of E) ⟶ X) (hp : p ≫ c = ξ k E)

/-- The actual rational point on the finite constant cover. -/
def constantPointLift :
    Spec (.of E) ⟶ constantBaseChangeCompactification k E c :=
  Limits.pullback.lift (𝟙 _) p ((Category.id_comp _).trans hp.symm)

/-- Its structural projection is the identity on the actual constant field. -/
@[reassoc]
theorem constantPointLift_structure :
    constantPointLift k E c p hp ≫ constantBaseChangeCompactificationStructure k E c =
      𝟙 _ := Limits.pullback.lift_fst _ _ _

/-- Its projection to the original curve is the specified residue morphism. -/
@[reassoc]
theorem constantPointLift_original :
    constantPointLift k E c p hp ≫
      ((FiniteEtale.pullback c).obj (originalConstantFieldCover k E)).hom = p :=
  Limits.pullback.lift_snd _ _ _

/-- The chosen point, rather than an unspecified point of the same fibre,
is retained by the original constant-cover projection. -/
theorem constantPointLift_original_point :
    ((FiniteEtale.pullback c).obj (originalConstantFieldCover k E)).hom
        (constantPointLift k E c p hp (IsLocalRing.closedPoint E)) =
      p (IsLocalRing.closedPoint E) :=
  congrArg (fun f : Spec (.of E) ⟶ X => f (IsLocalRing.closedPoint E))
    (constantPointLift_original k E c p hp)

end ConstantPoint

attribute [local instance] normalizationInertiaImageAction

attribute [local instance] boundaryInclusionDominant

/-- The literal generic source supplies the local fraction-field structure
for the nonabelian filling kernel. -/
theorem boundaryFilling_ker_eq_normalClosure_of_genericSource
    {X : Scheme.{0}} [IsIntegral X] [IsNormalIntegral X] [IsLocallyNoetherian X]
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    [Subsingleton (Component D)] [IsIntegral (D.1.supportComplement : Scheme)]
    (E : Component D) (x : X) (hx : componentPoint D E = x)
    (K Ω : Type) [Field K] [Field Ω]
    [Algebra K Ω] [IsSepClosure K Ω] [IsSepClosed Ω]
    (g : Spec (.of K) ⟶ D.1.supportComplement) [IsDominant g] [IsPreimmersion g] :
    let A := X.presheaf.stalk x
    let : Algebra A K := genericFieldSourceStalkAlgebra (g ≫ D.1.supportComplement.ι) x
    let : IsFractionRing A K :=
      genericFieldSourceStalk_isFractionRing (g ≫ D.1.supportComplement.ι) x
    let : Algebra A Ω := ((algebraMap K Ω).comp (algebraMap A K)).toAlgebra
    let : IsScalarTower A K Ω := IsScalarTower.of_algebraMap_eq' rfl
    ∀ (Q : Ideal (integralClosure A Ω)) [Q.IsMaximal],
      (fundamentalGroupHom D.1.supportComplement.ι (ξ K Ω ≫ g)).toMonoidHom.ker =
        (Subgroup.normalClosure
          ((Q.inertia Gal(Ω/K)).map (fieldSourceAbsoluteGaloisHom K Ω g).toMonoidHom :
            Set π₁ᵉᵗ(ξ K Ω ≫ g))).topologicalClosure := by
  subst x
  intro A instAK fraction instAΩ tower Q hQ
  exact boundaryFilling_ker_eq_normalClosure_normalizationInertia D hreg E K Ω g
    (genericFieldSourceStalkMap_fromSpecStalk
      (g ≫ D.1.supportComplement.ι) (componentPoint D E)).symm Q

/-- Filling the selected rational point of the actual finite constant cover
kills precisely the closed normal closure of its original full inertia. -/
theorem constantPointFilling_ker_eq_normalClosure_normalizationInertia
    (k E : Type) [Field k] [Field E] [Algebra k E]
    [IsFiniteEtale (Spec.map (CommRingCat.ofHom (algebraMap k E)))]
    {X : Scheme.{0}} [IsIntegral X] [IsNormalIntegral X] [IsLocallyNoetherian X]
    (c : X ⟶ Spec (.of k)) [GeometricallyConnected c]
    [IsSeparated c] [SmoothOfRelativeDimension 1 c]
    (p : Spec (.of E) ⟶ X) (hp : p ≫ c = ξ k E)
    (K Ω : Type) [Field K] [Field Ω]
    [Algebra K Ω] [IsSepClosure K Ω] [IsSepClosed Ω] :
    let cE := constantBaseChangeCompactificationStructure k E c
    let : IsSeparated cE :=
      inferInstanceAs (IsSeparated (Limits.pullback.fst (originalConstantFieldCover k E).hom c))
    let : SmoothOfRelativeDimension 1 cE :=
      (smoothOfRelativeDimension_isStableUnderBaseChange (n := 1)).of_isPullback
        (IsPullback.of_hasPullback (originalConstantFieldCover k E).hom c).flip
        (inferInstance : SmoothOfRelativeDimension 1 c)
    let pE := constantPointLift k E c p hp
    let hpoint := constantPointLift_structure k E c p hp
    let D := curvePointDivisor cE pE hpoint
    let : IsIntegral (D.1.supportComplement : Scheme) :=
      curvePointComplement_isIntegral cE pE hpoint
    ∀ (g : Spec (.of K) ⟶ D.1.supportComplement) [IsDominant g] [IsPreimmersion g],
      let A := (constantBaseChangeCompactification k E c).presheaf.stalk
        (pE (IsLocalRing.closedPoint E))
      let : Algebra A K := genericFieldSourceStalkAlgebra (g ≫ D.1.supportComplement.ι)
        (pE (IsLocalRing.closedPoint E))
      let : IsFractionRing A K := genericFieldSourceStalk_isFractionRing
        (g ≫ D.1.supportComplement.ι) (pE (IsLocalRing.closedPoint E))
      let : Algebra A Ω := ((algebraMap K Ω).comp (algebraMap A K)).toAlgebra
      let : IsScalarTower A K Ω := IsScalarTower.of_algebraMap_eq' rfl
      ∀ (Q : Ideal (integralClosure A Ω)) [Q.IsMaximal],
        (fundamentalGroupHom D.1.supportComplement.ι (ξ K Ω ≫ g)).toMonoidHom.ker =
          (Subgroup.normalClosure
            ((Q.inertia Gal(Ω/K)).map (fieldSourceAbsoluteGaloisHom K Ω g).toMonoidHom :
              Set π₁ᵉᵗ(ξ K Ω ≫ g))).topologicalClosure := by
  intro cE hSeparated hSmooth pE hpoint D hIntegral g hgdom hgpre
  have : Subsingleton (Component D) := curvePointDivisor_component_subsingleton cE pE hpoint
  exact boundaryFilling_ker_eq_normalClosure_of_genericSource
    D (curvePointDivisor_isAmbientRegularAlongSupport cE pE hpoint)
    (curvePointDivisorComponent cE pE hpoint) (pE (IsLocalRing.closedPoint E))
    (curvePointDivisor_componentPoint cE pE hpoint) K Ω g

end EtaleFundamentalGroups.Cohomology
