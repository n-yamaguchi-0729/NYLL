module

public import Nyll.EtaleFundamentalGroups.Pi1.Tame.FiniteTame
public import Nyll.EtaleFundamentalGroups.Pi1.GaloisCategories.TrivialMonodromyQuotient
public import Nyll.EtaleFundamentalGroups.Pi1.GaloisCategories.TrivialMonodromyFiber
public import Nyll.EtaleFundamentalGroups.Inertia.Tame.BoundaryWildCharZero
public import Nyll.ProCGroups.Topologies.ContinuousMulEquiv

/-!
# The tame fundamental group of a curve pair

Restriction of the usual geometric fibre functor gives the canonical
surjection from the étale fundamental group to the tame fundamental group.
At the geometric generic point its kernel is exactly the closed normal
subgroup generated by boundary wild inertia. This identifies the actual
fibre-functor automorphism group with the existing wild quotient.

The construction respects a change of geometric base point. In characteristic
zero every finite étale cover is tame and the canonical restriction is a
continuous group isomorphism.
-/

@[expose] public section

noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.FiniteEtale TopologicalSpace
open CategoryTheory.PreGaloisCategory
open scoped FintypeCatDiscrete

namespace EtaleFundamentalGroups.Tame

universe u v

attribute [local instance] AlgebraicGeometry.FiniteEtale.genericPoint_isDominant

variable {k : Type u} [Field k] {X U : Scheme.{u}} [IsIntegral X] [IsIntegral U]
  (c : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension 1 c]
  (j : U ⟶ X) [IsOpenImmersion j]

local notation "η" => Spec.map
  (CommRingCat.ofHom (algebraMap U.functionField (SeparableClosure U.functionField))) ≫
  U.fromSpecStalk (genericPoint U)
local notation "N" => boundaryWildKernel k U.functionField
  (SeparableClosure U.functionField) c j (U.fromSpecStalk (genericPoint U))

/-- Restrict an étale fibre-functor automorphism to the actual finite tame covers. -/
def tameProjection {Ω : Type u} [Field Ω] (x : Spec (.of Ω) ⟶ U) :
    π₁ᵉᵗ(x) →ₜ* π₁ᵗ(c, j, x) :=
  trivialMonodromyRestrictionAt (fiber η) N (fiber x)

/-- Restriction evaluates the original automorphism on the original cover. -/
@[simp] theorem tameProjection_apply {Ω : Type u} [Field Ω]
    (x : Spec (.of Ω) ⟶ U) (γ : π₁ᵉᵗ(x)) (W : FiniteTame c j)
    (a : (fiber x).obj W.obj) :
    (tameProjection c j x γ).asIso.hom.app W a = γ.asIso.hom.app W.obj a := rfl

/-- The étale-to-tame map is surjective at every geometric base point. -/
theorem tameProjection_surjective {Ω : Type u} [Field Ω] [IsSepClosed Ω]
    (x : Spec (.of Ω) ⟶ U) : Function.Surjective (tameProjection c j x) :=
  trivialMonodromyRestrictionAt_surjective (fiber η) N (fiber x)

/-- The generic étale-to-tame map kills exactly the original boundary wild kernel. -/
theorem tameProjection_ker :
    (tameProjection c j η).toMonoidHom.ker = N :=
  trivialMonodromyRestriction_ker (fiber η) N
    (boundaryWildKernel_isClosed k U.functionField (SeparableClosure U.functionField)
      c j (U.fromSpecStalk (genericPoint U)))

/-- The fundamental group defined by the tame-cover Galois category is the
original étale group modulo the closed normal boundary wild subgroup. -/
def tameQuotientEquiv :
    BoundaryWildQuotient k U.functionField (SeparableClosure U.functionField)
      c j (U.fromSpecStalk (genericPoint U)) ≃ₜ* π₁ᵗ(c, j, η) :=
  trivialMonodromyQuotientEquiv (fiber η) N
    (boundaryWildKernel_isClosed k U.functionField (SeparableClosure U.functionField)
      c j (U.fromSpecStalk (genericPoint U)))

/-- The quotient comparison carries the original quotient projection to restriction. -/
@[simp] theorem tameQuotientEquiv_projection (γ : π₁ᵉᵗ(η)) :
    tameQuotientEquiv c j
      (boundaryWildProjection k U.functionField (SeparableClosure U.functionField)
        c j (U.fromSpecStalk (genericPoint U)) γ) = tameProjection c j η γ := rfl

/-- A continuous map killing each actual boundary wild image descends to the
fundamental group of finite tame covers. -/
def tameLift {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : π₁ᵉᵗ(η) →ₜ* H)
    (hq : ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
      ∀ γ ∈ normalizationWildImageAt k U.functionField (SeparableClosure U.functionField)
        c j (U.fromSpecStalk (genericPoint U)) x hx, q γ = 1) :
    π₁ᵗ(c, j, η) →ₜ* H :=
  (boundaryWildLift k U.functionField (SeparableClosure U.functionField)
    c j (U.fromSpecStalk (genericPoint U)) q hq).comp
      (ContinuousMonoidHom.toContinuousMonoidHom (tameQuotientEquiv c j).symm)

/-- The descended map retains the value on every original étale representative. -/
@[simp] theorem tameLift_projection
    {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : π₁ᵉᵗ(η) →ₜ* H)
    (hq : ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
      ∀ γ ∈ normalizationWildImageAt k U.functionField (SeparableClosure U.functionField)
        c j (U.fromSpecStalk (genericPoint U)) x hx, q γ = 1)
    (γ : π₁ᵉᵗ(η)) :
    tameLift c j q hq (tameProjection c j η γ) = q γ := by
  rw [← tameQuotientEquiv_projection c j γ]
  change boundaryWildLift k U.functionField (SeparableClosure U.functionField)
    c j (U.fromSpecStalk (genericPoint U)) q hq
      ((tameQuotientEquiv c j).symm (tameQuotientEquiv c j _)) = q γ
  rw [ContinuousMulEquiv.symm_apply_apply]
  rfl

/-- The factor through the tame group is determined by the original étale map. -/
theorem tameLift_unique
    {H : Type v} [Group H] [TopologicalSpace H] [T2Space H]
    (q : π₁ᵉᵗ(η) →ₜ* H)
    (hq : ∀ (x : X) (hx : IsClosed ({x} : Set X)), x ∉ Set.range j →
      ∀ γ ∈ normalizationWildImageAt k U.functionField (SeparableClosure U.functionField)
        c j (U.fromSpecStalk (genericPoint U)) x hx, q γ = 1)
    (r : π₁ᵗ(c, j, η) →ₜ* H)
    (hr : ∀ γ, r (tameProjection c j η γ) = q γ) :
    r = tameLift c j q hq := by
  ext a
  obtain ⟨γ, rfl⟩ := tameProjection_surjective c j η a
  exact (hr γ).trans (tameLift_projection c j q hq γ).symm

/-- Restrict an actual comparison of geometric fibre functors to tame covers. -/
def tameBasepointChange {Ω Ω' : Type u} [Field Ω] [Field Ω']
    {x : Spec (.of Ω) ⟶ U} {y : Spec (.of Ω') ⟶ U} (t : fiber x ≅ fiber y) :
    π₁ᵗ(c, j, x) ≃ₜ* π₁ᵗ(c, j, y) :=
  trivialMonodromyFiberEquiv (fiber η) N t

/-- Base-point change commutes with the original étale-to-tame projections. -/
theorem tameBasepointChange_projection {Ω Ω' : Type u} [Field Ω] [Field Ω']
    {x : Spec (.of Ω) ⟶ U} {y : Spec (.of Ω') ⟶ U}
    (t : fiber x ≅ fiber y) (γ : π₁ᵉᵗ(x)) :
    tameBasepointChange c j t (tameProjection c j x γ) =
      tameProjection c j y (continuousConjAut t γ) :=
  trivialMonodromyFiberEquiv_restriction (fiber η) N t γ

section CharacteristicZero

variable [CharZero k]

/-- In characteristic zero every finite étale cover is tame at every boundary point. -/
theorem isTame_of_charZero (W : FiniteEtale U) : IsTame c j W := by
  change trivialMonodromy (fiber η) N W
  rw [boundaryWildKernel_eq_bot_of_charZero, trivialMonodromy_iff]
  intro γ hγ a
  have hγ' : γ = 1 := Subgroup.mem_bot.mp hγ
  rw [hγ', one_smul]

/-- The actual restriction is bijective in characteristic zero. -/
theorem tameProjection_bijective_of_charZero {Ω : Type u} [Field Ω] [IsSepClosed Ω]
    (x : Spec (.of Ω) ⟶ U) : Function.Bijective (tameProjection c j x) := by
  refine ⟨?_, tameProjection_surjective c j x⟩
  intro γ δ h
  apply Aut.ext
  apply Iso.ext
  ext W a
  let V : FiniteTame c j := ⟨W, isTame_of_charZero c j W⟩
  exact congrArg (fun q : π₁ᵗ(c, j, x) => q.asIso.hom.app V a) h

/-- Étale and tame fundamental groups coincide in characteristic zero through
the canonical restriction map, not through a chosen abstract group isomorphism. -/
def tameProjectionEquivOfCharZero {Ω : Type u} [Field Ω] [IsSepClosed Ω]
    (x : Spec (.of Ω) ⟶ U) : π₁ᵉᵗ(x) ≃ₜ* π₁ᵗ(c, j, x) :=
  ProCGroups.ContinuousMulEquiv.ofBijectiveCompactToT2
    (tameProjection c j x).toMonoidHom (tameProjection c j x).continuous_toFun
    (tameProjection_bijective_of_charZero c j x)

/-- The characteristic-zero equivalence is the original restriction on representatives. -/
@[simp] theorem tameProjectionEquivOfCharZero_apply
    {Ω : Type u} [Field Ω] [IsSepClosed Ω]
    (x : Spec (.of Ω) ⟶ U) (γ : π₁ᵉᵗ(x)) :
    tameProjectionEquivOfCharZero c j x γ = tameProjection c j x γ := rfl

end CharacteristicZero

end EtaleFundamentalGroups.Tame
