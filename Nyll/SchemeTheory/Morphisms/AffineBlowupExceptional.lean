import Nyll.SchemeTheory.Morphisms.AffineBlowupCharts
import Nyll.SchemeTheory.RingTheory.ReesChartRegular
import Nyll.SchemeTheory.Divisors.CartierOpenDescent
import Nyll.SchemeTheory.Sheaves.IdealSheafComap
import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
import Mathlib.Algebra.Ring.NonZeroDivisors

/-!
# The actual exceptional ideal of an affine blowup

The pullback of the original ideal is principal and regular on every
degree-one chart. The native affine cover and open descent therefore show
that its actual pullback ideal sheaf is an effective Cartier divisor.
This is the local exceptional-divisor assertion of Stacks Project 31.33.
-/

noncomputable section

universe u

open CategoryTheory

namespace AlgebraicGeometry

variable {R : Type u} [CommRing R]

private def specIdealSheaf (I : Ideal R) : (Spec (.of R)).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)

private theorem specIdealSheaf_comap {S : Type u} [CommRing S]
    (I : Ideal R) (φ : R →+* S) :
    (specIdealSheaf I).comap (Spec.map (CommRingCat.ofHom φ)) =
      specIdealSheaf (I.map φ) := by
  unfold specIdealSheaf
  rw [Scheme.IdealSheafData.comap_ofIdealTop, Ideal.map_map, Ideal.map_map]
  congr 1
  exact congrArg
    (fun g : CommRingCat.of R ⟶ Γ(Spec (CommRingCat.of S), ⊤) => I.map g.hom)
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ)).symm

private theorem specIdealSheaf_isEffectiveCartier (r : R) (hr : IsRegular r) :
    (specIdealSheaf (Ideal.span {r})).IsEffectiveCartier := by
  let X : Scheme.{u} := Spec (.of R)
  let e : Γ(X, ⊤) ≅ CommRingCat.of R := Scheme.ΓSpecIso (.of R)
  let b : Γ(X, ⊤) := e.inv.hom r
  have hb : e.hom.hom b = r := by
    change (e.inv ≫ e.hom).hom r = r
    rw [e.inv_hom_id]
    rfl
  have he : Function.Injective e.hom.hom :=
    (ConcreteCategory.bijective_of_isIso e.hom).injective
  intro x
  refine ⟨⟨⊤, isAffineOpen_top X⟩, Set.mem_univ x, b, ?_, ?_⟩
  · apply (Commute.isRegular_iff (Commute.all b)).mpr
    intro s t hst
    apply he
    apply hr.left
    have h := congrArg e.hom.hom hst
    simpa only [map_mul, hb] using h
  · unfold specIdealSheaf
    rw [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span, Set.image_singleton]
    change (Ideal.span {b}).map (RingHom.id Γ(X, ⊤)) = Ideal.span {b}
    exact Ideal.map_id _

/-- The actual inverse image of the original ideal sheaf on the affine blowup. -/
def affineBlowupExceptionalIdeal (I : Ideal R) : (affineBlowup I).IdealSheafData :=
  (specIdealSheaf I).comap (affineBlowupMap I)

/-- On the actual chart at `aT`, the exceptional ideal is generated by the
coefficient image of `a`. -/
private theorem affineBlowupExceptionalIdeal_comap_chart (I : Ideal R) (a : I) :
    (affineBlowupExceptionalIdeal I).comap (affineBlowupChartι I a) =
      specIdealSheaf (Ideal.span {ReesAlgebra.coefficientToChart I a a.val}) := by
  unfold affineBlowupExceptionalIdeal
  rw [← Scheme.IdealSheafData.comap_comp, affineBlowupChartι_map,
    specIdealSheaf_comap, ReesAlgebra.map_ideal_coefficientToChart]

/-- The actual exceptional ideal is an effective Cartier divisor,
without any regularity assumption on the original ideal or base ring. -/
theorem affineBlowupExceptionalIdeal_isEffectiveCartier (I : Ideal R) :
    (affineBlowupExceptionalIdeal I).IsEffectiveCartier := by
  intro x
  let C := affineBlowupAffineCover I
  obtain ⟨a, y, rfl⟩ := C.openCover.exists_eq x
  let a₀ : I := a
  have hc : ((affineBlowupExceptionalIdeal I).comap
      (affineBlowupChartι I a₀)).IsEffectiveCartier := by
    rw [affineBlowupExceptionalIdeal_comap_chart]
    apply specIdealSheaf_isEffectiveCartier
    exact isRegular_iff_mem_nonZeroDivisors.mpr
      (ReesAlgebra.coefficientToChart_mem_nonZeroDivisors I a₀)
  have h : ((affineBlowupExceptionalIdeal I).comap
      (C.openCover.f a)).IsEffectiveCartier := hc
  exact Scheme.IdealSheafData.isEffectiveCartierAt_of_comap_openImmersion
    (affineBlowupExceptionalIdeal I) (C.openCover.f a) y (h y)

end AlgebraicGeometry
