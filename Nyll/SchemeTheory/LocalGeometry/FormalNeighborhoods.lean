    Scheme.{u}} (f : X ⟶ S) [IsLocallyNoetherian S] [IsReduced S] [Nonempty S]
    [LocallyOfFiniteType f] [QuasiCompact f] :
    ∃ U : S.Opens, (U : Set S).Nonempty ∧ Flat ((f ⁻¹ᵁ U).ι ≫ f) :=
