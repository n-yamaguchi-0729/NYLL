/-!
# A finite presentation of an actual projective twist

First choose finite global generators of `F(a)`. The actual kernel is
quasicoherent and of finite type over the Noetherian base, so a further
twist of that kernel is generated by finitely many global sections.
Tensoring the first cokernel diagram with `O(b)` preserves its colimit,
and replacing its relation object by this actual free epimorphism gives

`O^I ⟶ O^J ⊗ O(b) ⟶ F(a + b) ⟶ 0`.

The result is an actual isomorphism from the categorical cokernel. The
conversion of its matrix entries to homogeneous polynomials is separate.
-/

noncomputable section

universe u

open CategoryTheory Limits MonoidalCategory

namespace AlgebraicGeometry.ProjSpace

open Scheme.Modules

attribute [local instance] MvPolynomial.gradedAlgebra

private theorem finiteType_free {X : Scheme.{u}} (I : Type u) [Finite I] :
    (SheafOfModules.free (R := X.ringCatSheaf) I).IsFiniteType := by
  let G := SheafOfModules.free.generatingSections (R := X.ringCatSheaf) I
  let q := G.localGeneratorsData
  have hq : q.IsFiniteType := by
    constructor
    intro U
    exact ⟨inferInstanceAs (Finite I)⟩
  exact q.isFiniteType hq

private def cokernelOfMappedKernel
    {C D : Type*} [Category C] [Category D] [Abelian C]
    [HasZeroMorphisms D] [HasCokernels D]
    (T : C ⥤ D) [T.PreservesZeroMorphisms]
    {P A : C} (f : P ⟶ A) [Epi f]
    [PreservesColimit (parallelPair (kernel.ι f) 0) T]
    {Q : D} (q : Q ⟶ T.obj (kernel f)) [Epi q] :
    cokernel (q ≫ T.map (kernel.ι f)) ≅ T.obj A := by
  let c : CokernelCofork (kernel.ι f) :=
    CokernelCofork.ofπ f (kernel.condition f)
  let hc : IsColimit c := Abelian.epiIsCokernelOfKernel
    (KernelFork.ofι (kernel.ι f) (kernel.condition f)) (kernelIsKernel f)
  let hd : IsColimit (c.map T) := CokernelCofork.mapIsColimit c hc T
  let he := isCokernelEpiComp hd q (h := q ≫ T.map (kernel.ι f)) rfl
  exact (cokernelIsCokernel (q ≫ T.map (kernel.ι f))).coconePointUniqueUpToIso he

private theorem finiteType_kernel_generatingSections
    {X : Scheme.{u}} [IsLocallyNoetherian X]
    (A : SheafOfModules.{u} X.ringCatSheaf) [A.IsQuasicoherent]
    (G : A.GeneratingSections) [G.IsFiniteType] :
    (kernel G.π).IsQuasicoherent ∧ (kernel G.π).IsFiniteType := by
  have : Finite G.I := SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := G)
  let P : SheafOfModules.{u} X.ringCatSheaf := SheafOfModules.free G.I
  have : P.IsQuasicoherent := inferInstance
  have : P.IsFiniteType := finiteType_free (X := X) G.I
  let f : P ⟶ A := G.π
  have hqc : (kernel f).IsQuasicoherent :=
    SheafOfModules.isQuasicoherent_kernel_native (X := X) f
  have hft : (kernel f).IsFiniteType :=
    SheafOfModules.isFiniteType_kernel_on_locallyNoetherian (X := X) f
  exact ⟨hqc, hft⟩

private def cokernelPresentationOfTwistedGenerators
    {X : Scheme.{u}} (A L : X.Modules) (G : A.GeneratingSections)
    (H : (Scheme.Modules.tensor (X := X)
      (show X.Modules from kernel G.π) L).GeneratingSections) :
    Σ φ : (show X.Modules from SheafOfModules.free H.I) ⟶
      (show X.Modules from SheafOfModules.free G.I) ⊗ L,
      cokernel φ ≅ A ⊗ L := by
  let E : X.Modules ≌ SheafOfModules.{u} X.ringCatSheaf := sheafOfModulesEquivalence X
  let P : SheafOfModules.{u} X.ringCatSheaf := SheafOfModules.free G.I
  let K : SheafOfModules.{u} X.ringCatSheaf := kernel G.π
  have : Epi H.π := H.epi
  have : Epi G.π := G.epi
  let T : SheafOfModules.{u} X.ringCatSheaf ⥤ X.Modules := E.inverse ⋙ tensorRight L
  have : E.inverse.IsLeftAdjoint := E.symm.toAdjunction.isLeftAdjoint
  have : (tensorRight L).IsLeftAdjoint := inferInstance
  have : PreservesColimitsOfSize.{u, u} T := inferInstance
  have : T.PreservesZeroMorphisms := inferInstance
  let q : (show X.Modules from SheafOfModules.free H.I) ⟶ T.obj K :=
    E.inverse.map H.π
  have : Epi q := CategoryTheory.Functor.map_epi E.inverse H.π
  let φ : (show X.Modules from SheafOfModules.free H.I) ⟶ T.obj P :=
    q ≫ T.map (kernel.ι G.π)
  let e := cokernelOfMappedKernel T G.π q
  exact ⟨φ, e⟩

private theorem finiteCokernelPresentationOfGlobalGeneration
    {X : Scheme.{u}} [IsLocallyNoetherian X] (L : X.Modules)
    (hgen : ∀ M : X.Modules,
      SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M →
      SheafOfModules.IsFiniteType (R := X.ringCatSheaf) M →
      ∃ N : ℕ, ∀ d : ℕ, N ≤ d →
        ∃ G : (M ⊗ L.tensorPow d).GeneratingSections, G.IsFiniteType)
    (hqc : ∀ M : X.Modules,
      SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) M → ∀ d : ℕ,
      SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf)
        (Scheme.Modules.tensor (X := X) M (L.tensorPow d)))
    (F : X.Modules)
    [SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) F]
    [SheafOfModules.IsFiniteType (R := X.ringCatSheaf) F] :
    ∃ a b : ℕ, ∃ I J : Type u, Finite I ∧ Finite J ∧
      ∃ φ : (show X.Modules from SheafOfModules.free I) ⟶
        (show X.Modules from SheafOfModules.free J) ⊗ L.tensorPow b,
        Nonempty (cokernel φ ≅ F ⊗ L.tensorPow (a + b)) := by
  obtain ⟨a, ha⟩ := hgen F inferInstance inferInstance
  obtain ⟨G, hG⟩ := ha a le_rfl
  have : G.IsFiniteType := hG
  have : Finite G.I := SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := G)
  let A : X.Modules := F ⊗ L.tensorPow a
  let K : SheafOfModules.{u} X.ringCatSheaf := kernel G.π
  have : SheafOfModules.IsQuasicoherent (R := X.ringCatSheaf) A := hqc F inferInstance a
  obtain ⟨hKqc, hKft⟩ := finiteType_kernel_generatingSections (X := X) A G
  have : K.IsQuasicoherent := hKqc
  have : K.IsFiniteType := hKft
  obtain ⟨b, hb⟩ := hgen (show X.Modules from K) hKqc hKft
  obtain ⟨H, hH⟩ := hb b le_rfl
  have : H.IsFiniteType := hH
  have : Finite H.I := SheafOfModules.GeneratingSections.IsFiniteType.finite (σ := H)
  let B : X.Modules := L.tensorPow b
  obtain ⟨φ, e⟩ := cokernelPresentationOfTwistedGenerators A B G H
  let eTwist : A ⊗ B ≅ F ⊗ L.tensorPow (a + b) :=
    (α_ F (L.tensorPow a) (L.tensorPow b)) ≪≫ whiskerLeftIso F (tensorPowAdd L a b)
  exact ⟨a, b, H.I, G.I, inferInstance, inferInstance, φ, ⟨e ≪≫ eTwist⟩⟩

variable (R : Type u) [CommRing R] [IsNoetherianRing R] (n : ℕ)

local notation "𝒜" => MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R

/-- A finite-type quasicoherent sheaf on projective space has a twist
which is the actual cokernel of a map from a finite free sheaf to a
nonnegative twist of a finite free sheaf. Both finite families and the
presenting morphism are constructed from actual global sections. -/
theorem exists_twisting_finite_cokernel_presentation
    (F : (Proj 𝒜).Modules)
    [SheafOfModules.IsQuasicoherent (R := (Proj 𝒜).ringCatSheaf) F]
    [SheafOfModules.IsFiniteType (R := (Proj 𝒜).ringCatSheaf) F] :
    ∃ a b : ℕ, ∃ I J : Type u, Finite I ∧ Finite J ∧
      ∃ φ : (show (Proj 𝒜).Modules from SheafOfModules.free I) ⟶
        (show (Proj 𝒜).Modules from SheafOfModules.free J) ⊗
          (twistingSheaf R n).tensorPow b,
        Nonempty (cokernel φ ≅ F ⊗ (twistingSheaf R n).tensorPow (a + b)) := by
  have : IsLocallyNoetherian (Proj 𝒜) :=
    LocallyOfFiniteType.isLocallyNoetherian (π R n)
  exact finiteCokernelPresentationOfGlobalGeneration (twistingSheaf R n)
    (fun M hMqc hMft => by
      have : SheafOfModules.IsQuasicoherent (R := (Proj 𝒜).ringCatSheaf) M := hMqc
      have : SheafOfModules.IsFiniteType (R := (Proj 𝒜).ringCatSheaf) M := hMft
      exact exists_twisting_bound_generatingSections R n M)
    (fun M hMqc d => by
      have : SheafOfModules.IsQuasicoherent (R := (Proj 𝒜).ringCatSheaf) M := hMqc
      exact isQuasicoherent_tensor_twistingSheaf R n M d) F

end AlgebraicGeometry.ProjSpace
