import Nyll.SchemeTheory.RingTheory.ReesDegreeOne
import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization

/-!
# The actual degree-one charts of a Rees algebra

The homogeneous localization at `aT` contains the native fractions `b/a`
for `b ∈ I`. The extension of `I` is the principal ideal generated by `a`.
This is the chart calculation in Stacks Project, Section 31.33.
-/

noncomputable section

universe u

namespace ReesAlgebra

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- The native homogeneous localization at the degree-one element `aT`. -/
abbrev Chart (a : I) :=
  HomogeneousLocalization.Away (homogeneousPart I) (degreeOne I a)

/-- The actual coefficient homomorphism to a degree-one chart. -/
def coefficientToChart (a : I) : R →+* Chart I a :=
  (HomogeneousLocalization.fromZeroRingHom (homogeneousPart I)
    (Submonoid.powers (degreeOne I a))).comp (degreeZeroEquiv I).toRingHom

/-- The actual homogeneous fraction `(bT)/(aT)` in the chart at `aT`. -/
def chartRatio (a b : I) : Chart I a :=
  HomogeneousLocalization.Away.mk (homogeneousPart I) (degreeOne_mem I a) 1
    (degreeOne I b) (by simpa only [one_smul] using degreeOne_mem I b)

/-- Evaluation of the coefficient map in the ordinary localization. -/
lemma val_coefficientToChart (a : I) (r : R) :
    (coefficientToChart I a r).val =
      Localization.mk (algebraMap R (reesAlgebra I) r)
        (1 : Submonoid.powers (degreeOne I a)) := rfl

/-- Evaluation of the actual degree-one fraction. -/
lemma val_chartRatio (a b : I) :
    (chartRatio I a b).val =
      Localization.mk (degreeOne I b)
        (⟨degreeOne I a ^ 1, ⟨1, rfl⟩⟩ : Submonoid.powers (degreeOne I a)) := rfl

/-- Multiplying the native ratio by its coefficient denominator recovers
its coefficient numerator, including when the original ideal has zero divisors. -/
theorem coefficient_mul_chartRatio (a b : I) :
    coefficientToChart I a a.val * chartRatio I a b = coefficientToChart I a b.val := by
  apply HomogeneousLocalization.val_injective (Submonoid.powers (degreeOne I a))
  rw [HomogeneousLocalization.val_mul, val_coefficientToChart, val_chartRatio,
    val_coefficientToChart]
  rw [Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simp only [OneMemClass.coe_one, one_mul, pow_one]
  apply Subtype.ext
  change Polynomial.C a.val * Polynomial.monomial 1 b.val =
    Polynomial.monomial 1 a.val * Polynomial.C b.val
  rw [mul_comm (Polynomial.monomial 1 a.val), Polynomial.C_mul_monomial,
    Polynomial.C_mul_monomial, mul_comm a.val b.val]

/-- The extended ideal on the actual chart is generated by its denominator. -/
theorem map_ideal_coefficientToChart (a : I) :
    I.map (coefficientToChart I a) = Ideal.span {coefficientToChart I a a.val} := by
  apply le_antisymm
  · apply Ideal.map_le_iff_le_comap.mpr
    intro b hb
    apply Ideal.mem_span_singleton.mpr
    exact ⟨chartRatio I a ⟨b, hb⟩, (coefficient_mul_chartRatio I a ⟨b, hb⟩).symm⟩
  · apply Ideal.span_le.mpr
    intro b hb
    obtain rfl := Set.mem_singleton_iff.mp hb
    exact Ideal.mem_map_of_mem (coefficientToChart I a) a.property

end ReesAlgebra
