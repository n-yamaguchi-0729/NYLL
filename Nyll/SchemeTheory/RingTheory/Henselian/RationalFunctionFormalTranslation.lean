import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.RingTheory.Algebraic.Defs
import Mathlib.RingTheory.Localization.Basic
import Mathlib.RingTheory.PowerSeries.Inverse

/-! # Formal translation of rational functions at a transcendental element

Polynomial evaluation at `C t + X` sends every nonzero denominator to a unit:
its constant coefficient is the nonzero value at the transcendental element
`t`. Localization therefore constructs an actual algebra homomorphism from
`RatFunc K` into `PowerSeries F`. Its constant coefficient is the existing
rational-function embedding into the intermediate field generated by `t`,
followed by that field's inclusion into `F`.
-/

noncomputable section

open scoped nonZeroDivisors

namespace RatFunc

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

private theorem constantCoeff_aeval_translation (t : F) (P : Polynomial K) :
    PowerSeries.constantCoeff
        (Polynomial.aeval (PowerSeries.C t + PowerSeries.X) P) =
      Polynomial.aeval t P := by
  have h : (PowerSeries.constantCoeff (R := F)).comp
      (Polynomial.aeval (PowerSeries.C t + PowerSeries.X) :
        Polynomial K →ₐ[K] PowerSeries F).toRingHom =
      (Polynomial.aeval t : Polynomial K →ₐ[K] F).toRingHom := by
    apply Polynomial.ringHom_ext
    · intro a
      change PowerSeries.constantCoeff
          (Polynomial.aeval (PowerSeries.C t + PowerSeries.X) (Polynomial.C a)) =
        Polynomial.aeval t (Polynomial.C a)
      simp only [Polynomial.aeval_C, PowerSeries.algebraMap_apply,
        PowerSeries.constantCoeff_C]
    · change PowerSeries.constantCoeff
          (Polynomial.aeval (PowerSeries.C t + PowerSeries.X) Polynomial.X) =
        Polynomial.aeval t Polynomial.X
      simp only [Polynomial.aeval_X, map_add, PowerSeries.constantCoeff_C,
        PowerSeries.constantCoeff_X, add_zero]
  exact RingHom.congr_fun h P

/-- Every nonzero polynomial denominator becomes a unit after formal
translation at a transcendental element. -/
theorem formalTranslation_denominator_isUnit (t : F) (ht : Transcendental K t)
    (Q : Polynomial K) (hQ : Q ≠ 0) :
    IsUnit (Polynomial.aeval (PowerSeries.C t + PowerSeries.X) Q) := by
  apply PowerSeries.isUnit_iff_constantCoeff.mpr
  rw [constantCoeff_aeval_translation]
  apply isUnit_iff_ne_zero.mpr
  intro h
  exact hQ ((transcendental_iff.mp ht) Q h)

/-- The actual translated rational-function homomorphism, constructed by
localizing polynomial evaluation at `C t + X`. -/
def formalTranslation (t : F) (ht : Transcendental K t) :
    RatFunc K →ₐ[K] PowerSeries F :=
  IsLocalization.liftAlgHom (S := RatFunc K) (M := (Polynomial K)⁰)
    (f := Polynomial.aeval (PowerSeries.C t + PowerSeries.X))
    (fun Q => formalTranslation_denominator_isUnit t ht Q
      (mem_nonZeroDivisors_iff_ne_zero.mp Q.property))

/-- Formal translation agrees with actual polynomial evaluation. -/
theorem formalTranslation_algebraMap (t : F) (ht : Transcendental K t)
    (P : Polynomial K) :
    formalTranslation t ht (algebraMap (Polynomial K) (RatFunc K) P) =
      Polynomial.aeval (PowerSeries.C t + PowerSeries.X) P := by
  exact IsLocalization.lift_eq (S := RatFunc K)
    (fun Q : (Polynomial K)⁰ => formalTranslation_denominator_isUnit t ht Q
      (mem_nonZeroDivisors_iff_ne_zero.mp Q.property)) P

/-- The rational variable is sent to `t + X`, with `t` viewed as a constant series. -/
theorem formalTranslation_X (t : F) (ht : Transcendental K t) :
    formalTranslation t ht RatFunc.X = PowerSeries.C t + PowerSeries.X := by
  rw [← RatFunc.algebraMap_X, formalTranslation_algebraMap, Polynomial.aeval_X]

/-- Constants retain their actual base-field embedding. -/
theorem formalTranslation_C (t : F) (ht : Transcendental K t) (a : K) :
    formalTranslation t ht (RatFunc.C a) = PowerSeries.C (algebraMap K F a) := by
  change formalTranslation t ht (algebraMap K (RatFunc K) a) = _
  rw [AlgHom.commutes, PowerSeries.algebraMap_apply]

/-- Taking constant coefficients of the translated homomorphism gives the
existing embedding of rational functions obtained from the transcendental element. -/
theorem constantCoeff_comp_formalTranslation (t : F) (ht : Transcendental K t) :
    (PowerSeries.constantCoeff (R := F)).comp (formalTranslation t ht).toRingHom =
      ((IntermediateField.adjoin K {t}).val.comp
        (RatFunc.algEquivOfTranscendental t ht).toAlgHom).toRingHom := by
  apply IsLocalization.ringHom_ext (nonZeroDivisors (Polynomial K))
  apply Polynomial.ringHom_ext
  · intro a
    change PowerSeries.constantCoeff
        (formalTranslation t ht (algebraMap K (RatFunc K) a)) =
      ((IntermediateField.adjoin K {t}).val.comp
        (RatFunc.algEquivOfTranscendental t ht).toAlgHom)
        (algebraMap K (RatFunc K) a)
    rw [AlgHom.commutes, AlgHom.commutes, PowerSeries.algebraMap_apply,
      PowerSeries.constantCoeff_C]
  · change PowerSeries.constantCoeff (formalTranslation t ht RatFunc.X) =
      ((RatFunc.algEquivOfTranscendental t ht RatFunc.X :
        IntermediateField.adjoin K {t}) : F)
    rw [formalTranslation_X, map_add, PowerSeries.constantCoeff_C,
      PowerSeries.constantCoeff_X, add_zero]
    exact (RatFunc.algEquivOfTranscendental_X t ht).symm

/-- The constant-term formula for an arbitrary rational function. -/
theorem constantCoeff_formalTranslation (t : F) (ht : Transcendental K t)
    (f : RatFunc K) :
    PowerSeries.constantCoeff (formalTranslation t ht f) =
      ((RatFunc.algEquivOfTranscendental t ht f :
        IntermediateField.adjoin K {t}) : F) :=
  RingHom.congr_fun (constantCoeff_comp_formalTranslation t ht) f

end RatFunc
