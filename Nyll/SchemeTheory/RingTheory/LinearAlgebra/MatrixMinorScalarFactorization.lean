module

public import Mathlib.LinearAlgebra.Matrix.Adjugate
public import Mathlib.LinearAlgebra.Span.Defs
public import Mathlib.RingTheory.Ideal.Basic

/-!
# Scalar factorizations from maximal minors

An element of the ideal generated by the maximal minors of a rectangular
matrix is a scalar for which the matrix admits a scaled right inverse.
Each minor supplies such a matrix by the existing adjugate identity;
span induction combines these matrices.

This is the linear algebra construction used in Stacks Project,
Lemma 16.7.1, after evaluating the Jacobian minors:
https://stacks.math.columbia.edu/tag/07CR
-/

@[expose] public section

noncomputable section

namespace Matrix

/-- Membership in the ideal of maximal minors supplies an actual
matrix whose product is the given scalar times the identity. -/
theorem exists_mul_eq_smul_one_of_mem_span_maximalMinors
    {R m n : Type*} [CommRing R] [Fintype m] [Fintype n] [DecidableEq m]
    (A : Matrix m n R) (d : R)
    (hd : d ∈ Ideal.span (Set.range fun c : m → n => (A.submatrix id c).det)) :
    ∃ S : Matrix n m R, A * S = d • (1 : Matrix m m R) := by
  classical
  induction hd using Submodule.span_induction with
  | mem d hd =>
    obtain ⟨c, rfl⟩ := hd
    refine ⟨(1 : Matrix n n R).submatrix id c * (A.submatrix id c).adjugate, ?_⟩
    rw [← Matrix.mul_assoc]
    have hselect : A * (1 : Matrix n n R).submatrix id c = A.submatrix id c := by
      exact Matrix.mul_submatrix_one (Equiv.refl n) c A
    rw [hselect, Matrix.mul_adjugate]
  | zero =>
    refine ⟨0, ?_⟩
    rw [Matrix.mul_zero, zero_smul]
  | add a b _ha _hb ha hb =>
    obtain ⟨S, hS⟩ := ha
    obtain ⟨T, hT⟩ := hb
    refine ⟨S + T, ?_⟩
    rw [Matrix.mul_add, hS, hT, add_smul]
  | smul r a _ha ha =>
    obtain ⟨S, hS⟩ := ha
    refine ⟨r • S, ?_⟩
    rw [Matrix.mul_smul, hS, smul_smul, smul_eq_mul]

end Matrix
