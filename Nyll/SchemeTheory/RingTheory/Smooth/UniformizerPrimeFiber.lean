import Mathlib.Algebra.Ring.Equiv
import Mathlib.Algebra.Ring.Hom.Defs
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# A uniformizer is prime on a flat chart with integral closed fibre

For a flat algebra over a DVR, an integral closed fibre makes the image
of a uniformizer prime. The actual residue tensor is identified with
the quotient by the extended maximal ideal, and that ideal is computed
as the principal ideal generated by the uniformizer image. Flatness
ensures that this image is nonzero.

This supplies the prime parameter required by the root-normalization
calculation from the integral closed-fibre chart constructed geometrically.
No domain hypothesis on the entire algebra is needed for this step.
-/

namespace SchemeTheory

open scoped TensorProduct

universe u v

/-- An integral residue tensor makes the image of a uniformizer prime
in a flat algebra over a DVR. -/
theorem prime_uniformizer_image_of_isDomain_closedFiber
    (B : Type u) (R : Type v)
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [CommRing R] [Algebra B R] [Module.Flat B R]
    [IsDomain (R ⊗[B] IsLocalRing.ResidueField B)]
    (π : B) (hπ : Prime π) : Prime (algebraMap B R π) := by
  have : Nontrivial R :=
    (algebraMap R (R ⊗[B] IsLocalRing.ResidueField B)).domain_nontrivial
  have hregular : IsSMulRegular R π :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors
      (mem_nonZeroDivisors_iff_ne_zero.mpr hπ.ne_zero)
  have hne : algebraMap B R π ≠ 0 := by
    intro hzero
    apply (one_ne_zero : (1 : R) ≠ 0)
    apply hregular
    simp only [Algebra.smul_def, mul_one, mul_zero, hzero]
  let I := (IsLocalRing.maximalIdeal B).map (algebraMap B R)
  let e : (R ⧸ I) ≃ₐ[R] R ⊗[B] IsLocalRing.ResidueField B :=
    Algebra.TensorProduct.quotIdealMapEquivTensorQuot R (IsLocalRing.maximalIdeal B)
  have : IsDomain (R ⧸ I) := e.toRingEquiv.toMulEquiv.isDomain _
  have hI : I.IsPrime := (Ideal.Quotient.isDomain_iff_prime I).mp inferInstance
  have hspan : I = Ideal.span ({algebraMap B R π} : Set R) := by
    change (IsLocalRing.maximalIdeal B).map (algebraMap B R) = _
    rw [hπ.irreducible.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  exact (Ideal.span_singleton_prime hne).mp (hspan ▸ hI)

end SchemeTheory
