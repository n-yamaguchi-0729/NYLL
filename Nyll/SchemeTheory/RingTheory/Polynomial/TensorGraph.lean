module

public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Quotient
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.TensorProduct.Maps

/-!
# Polynomial graph quotients of tensor products

For any two algebras over an integer polynomial ring, the tensor product
over that polynomial ring is the quotient of their integer tensor product
by the coordinate graph relations. Equality on the polynomial generators
imposes every scalar-balance relation, using the existing description of
the kernel of the linear tensor change-of-scalars map.

No completion, localization, regularity, or derivation is assumed here.
The quotient equivalence preserves the literal canonical tensor map.
-/

@[expose] public section

noncomputable section

open scoped TensorProduct

universe u v w

namespace Algebra.TensorProduct

variable (σ : Type u) (A : Type v) (B : Type w) [CommRing A] [CommRing B]
  [Algebra (MvPolynomial σ ℤ) A]

/-- The graph relation comparing a polynomial coordinate in the left
algebra with its prescribed value in the right algebra. -/
def polynomialGraphRelation (b : σ → B) (j : σ) : A ⊗[ℤ] B :=
  algebraMap (MvPolynomial σ ℤ) A (MvPolynomial.X j) ⊗ₜ[ℤ] (1 : B) -
    1 ⊗ₜ[ℤ] b j

variable [Algebra (MvPolynomial σ ℤ) B]

/-- The canonical change of scalars kills each coordinate graph relation. -/
theorem polynomialGraphRelation_map_eq_zero (j : σ) :
    mapOfCompatibleSMul (MvPolynomial σ ℤ) ℤ ℤ A B
      (polynomialGraphRelation σ A B
        (fun i => algebraMap (MvPolynomial σ ℤ) B (MvPolynomial.X i)) j) = 0 := by
  rw [polynomialGraphRelation, map_sub,
    mapOfCompatibleSMul_tmul, mapOfCompatibleSMul_tmul]
  apply sub_eq_zero.mpr
  simpa only [Algebra.smul_def, mul_one] using
    (_root_.TensorProduct.smul_tmul (R := MvPolynomial σ ℤ) (R' := MvPolynomial σ ℤ)
      (MvPolynomial.X j) (1 : A) (1 : B))

/-- The ideal generated by the actual coordinate graph relations. -/
def polynomialGraphIdeal : Ideal (A ⊗[ℤ] B) :=
  Ideal.span (Set.range (polynomialGraphRelation σ A B
    (fun i => algebraMap (MvPolynomial σ ℤ) B (MvPolynomial.X i))))

/-- Every coordinate graph relation belongs to the kernel of the
canonical change-of-scalars map. -/
theorem polynomialGraphIdeal_le_ker :
    polynomialGraphIdeal σ A B ≤ RingHom.ker
      (mapOfCompatibleSMul (MvPolynomial σ ℤ) ℤ ℤ A B) := by
  apply Ideal.span_le.mpr
  rintro x ⟨j, rfl⟩
  exact polynomialGraphRelation_map_eq_zero σ A B j

/-- The graph generators impose every polynomial scalar balance, so
there are no further relations in the kernel of the canonical map. -/
theorem polynomialGraphIdeal_eq_ker :
    polynomialGraphIdeal σ A B = RingHom.ker
      (Algebra.TensorProduct.mapOfCompatibleSMul (MvPolynomial σ ℤ) ℤ ℤ
        A B) := by
  apply le_antisymm (polynomialGraphIdeal_le_ker σ A B)
  let P := MvPolynomial σ ℤ
  let J : Ideal (A ⊗[ℤ] B) := polynomialGraphIdeal σ A B
  let Q := (A ⊗[ℤ] B) ⧸ J
  let q : A ⊗[ℤ] B →ₐ[ℤ] Q := Ideal.Quotient.mkₐ ℤ J
  let f : P →ₐ[ℤ] Q := q.comp
    (Algebra.TensorProduct.includeLeft.comp (IsScalarTower.toAlgHom ℤ P A))
  let g : P →ₐ[ℤ] Q := q.comp
    (Algebra.TensorProduct.includeRight.comp (IsScalarTower.toAlgHom ℤ P B))
  have hfg : f = g := by
    apply MvPolynomial.algHom_ext
    intro i
    change Ideal.Quotient.mk J
        (algebraMap P A (MvPolynomial.X i) ⊗ₜ[ℤ] (1 : B)) =
      Ideal.Quotient.mk J ((1 : A) ⊗ₜ[ℤ] algebraMap P B (MvPolynomial.X i))
    apply Ideal.Quotient.eq.mpr
    exact Ideal.subset_span ⟨i, rfl⟩
  have hbalance (p : P) (a : A) (b : B) :
      (p • a) ⊗ₜ[ℤ] b - a ⊗ₜ[ℤ] (p • b) ∈ J := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q ((p • a) ⊗ₜ[ℤ] b - a ⊗ₜ[ℤ] (p • b)) = 0
    rw [map_sub]
    apply sub_eq_zero.mpr
    have hp : q (algebraMap P A p ⊗ₜ[ℤ] (1 : B)) =
        q ((1 : A) ⊗ₜ[ℤ] algebraMap P B p) :=
      DFunLike.congr_fun hfg p
    have hprod := congrArg (fun z : Q => z * q (a ⊗ₜ[ℤ] b)) hp
    simpa only [← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
      one_mul, Algebra.smul_def] using hprod
  have hspan : Submodule.span P
      { (p • a) ⊗ₜ[ℤ] b - a ⊗ₜ[ℤ] (p • b) | (p : P) (a : A) (b : B) } ≤
        J.restrictScalars P := by
    apply Submodule.span_le.mpr
    rintro x ⟨p, a, b, rfl⟩
    exact hbalance p a b
  intro x hx
  change x ∈ (_root_.TensorProduct.mapOfCompatibleSMul P ℤ P A B).ker at hx
  rw [_root_.TensorProduct.AlgebraTensorModule.ker_mapOfCompatibleSMul] at hx
  exact hspan hx

/-- The graph quotient is the actual tensor product over the original
polynomial ring, not merely a surjective approximation to it. -/
def polynomialGraphQuotientEquivTensor :
    ((A ⊗[ℤ] B) ⧸ polynomialGraphIdeal σ A B) ≃ₐ[ℤ]
      A ⊗[MvPolynomial σ ℤ] B :=
  (Ideal.quotientEquivAlgOfEq ℤ (polynomialGraphIdeal_eq_ker σ A B)).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (Algebra.TensorProduct.mapOfCompatibleSMul_surjective (MvPolynomial σ ℤ) ℤ ℤ
        A B))

/-- The quotient equivalence preserves the literal tensor comparison. -/
theorem polynomialGraphQuotientEquivTensor_mk
    (x : A ⊗[ℤ] B) :
    polynomialGraphQuotientEquivTensor σ A B (Ideal.Quotient.mk _ x) =
      Algebra.TensorProduct.mapOfCompatibleSMul (MvPolynomial σ ℤ) ℤ ℤ
        A B x := by
  change Ideal.quotientKerAlgEquivOfSurjective
    (mapOfCompatibleSMul_surjective (MvPolynomial σ ℤ) ℤ ℤ A B)
    (Ideal.quotientEquivAlgOfEq ℤ (polynomialGraphIdeal_eq_ker σ A B)
      (Ideal.Quotient.mk _ x)) = _
  rw [Ideal.quotientEquivAlgOfEq_mk, Ideal.quotientKerAlgEquivOfSurjective_mk]

end Algebra.TensorProduct
